{
  "$defs": {
    "DraftEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "policy": {
          "enum": [
            "replace-input",
            "add-residual",
            "concat",
            "fanout",
            "disconnect"
          ],
          "title": "Policy",
          "type": "string"
        },
        "source_port_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Source Port Id",
          "type": "string"
        },
        "target_port_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target Port Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_port_id",
        "target_port_id",
        "policy"
      ],
      "title": "DraftEdge",
      "type": "object"
    },
    "DraftNode": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "minLength": 1,
          "title": "Node Type",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/DraftPort"
          },
          "title": "Ports",
          "type": "array"
        },
        "semantic_name": {
          "minLength": 1,
          "title": "Semantic Name",
          "type": "string"
        },
        "source_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Anchor"
        }
      },
      "required": [
        "node_id",
        "semantic_name",
        "framework",
        "node_type"
      ],
      "title": "DraftNode",
      "type": "object"
    },
    "DraftPort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "port_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Port Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "shape_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape Constraint"
        }
      },
      "required": [
        "port_id",
        "name",
        "direction",
        "role"
      ],
      "title": "DraftPort",
      "type": "object"
    },
    "EditIntent": {
      "additionalProperties": false,
      "properties": {
        "capability_requirement": {
          "minLength": 1,
          "title": "Capability Requirement",
          "type": "string"
        },
        "expected_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphDelta"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intent_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Intent Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "create-node",
            "delete-node",
            "connect-ports",
            "disconnect-edge",
            "replace-node",
            "set-parameter",
            "edit-source-buffer",
            "edit-onnx-initializer",
            "edit-onnx-attribute"
          ],
          "title": "Kind",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "user_input": {
          "additionalProperties": true,
          "title": "User Input",
          "type": "object"
        }
      },
      "required": [
        "intent_id",
        "kind",
        "capability_requirement"
      ],
      "title": "EditIntent",
      "type": "object"
    },
    "EditProofState": {
      "enum": [
        "checking",
        "conditional",
        "unproven",
        "invalid",
        "stale",
        "proven",
        "review-ready"
      ],
      "title": "EditProofState",
      "type": "string"
    },
    "EditProofStatus": {
      "additionalProperties": false,
      "properties": {
        "affected_subject_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Affected Subject Ids",
          "type": "array"
        },
        "checked_generation": {
          "minimum": 1,
          "title": "Checked Generation",
          "type": "integer"
        },
        "input_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Fingerprint",
          "type": "string"
        },
        "intent_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Intent Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_facts": {
          "items": {
            "type": "string"
          },
          "title": "Required Facts",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EditProofState"
        },
        "supported_fixes": {
          "items": {
            "type": "string"
          },
          "title": "Supported Fixes",
          "type": "array"
        },
        "writeback_eligibility": {
          "enum": [
            "blocked",
            "prepare",
            "commit"
          ],
          "title": "Writeback Eligibility",
          "type": "string"
        }
      },
      "required": [
        "intent_id",
        "status",
        "writeback_eligibility",
        "message",
        "checked_generation",
        "input_fingerprint"
      ],
      "title": "EditProofStatus",
      "type": "object"
    },
    "FactDelta": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "kind": {
          "enum": [
            "node",
            "edge",
            "tensor",
            "port",
            "fanout",
            "repeat",
            "config-predicate",
            "evidence",
            "unresolved"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "kind"
      ],
      "title": "FactDelta",
      "type": "object"
    },
