    "ParameterDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After"
        },
        "before": {
          "title": "Before"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "parameter_name": {
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        },
        "source_expression": {
          "minLength": 1,
          "title": "Source Expression",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter_name",
        "before",
        "after",
        "source_expression"
      ],
      "title": "ParameterDelta",
      "type": "object"
    },
    "ShapeDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minLength": 1,
