  "additionalProperties": false,
  "properties": {
    "base_architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Base Architecture Id",
      "type": "string"
    },
    "base_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Source Digest",
      "type": "string"
    },
    "draft_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Draft Id",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/DraftEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "intents": {
      "items": {
        "$ref": "#/$defs/EditIntent"
      },
      "title": "Intents",
      "type": "array"
    },
    "lowering_status": {
      "default": "not-planned",
      "enum": [
        "not-planned",
        "checking",
        "planned",
        "blocked"
      ],
      "title": "Lowering Status",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/DraftNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "proofs": {
      "items": {
        "$ref": "#/$defs/EditProofStatus"
      },
      "title": "Proofs",
      "type": "array"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
