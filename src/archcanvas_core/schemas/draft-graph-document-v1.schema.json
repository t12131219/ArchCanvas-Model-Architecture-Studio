      "type": "object"
    },
    "WritebackSummary": {
      "additionalProperties": false,
      "properties": {
        "blocking_intent_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Blocking Intent Ids",
          "type": "array"
        },
        "eligibility": {
          "default": "blocked",
          "enum": [
            "blocked",
            "prepare",
            "commit"
          ],
          "title": "Eligibility",
          "type": "string"
        }
      },
      "title": "WritebackSummary",
      "type": "object"
    }
