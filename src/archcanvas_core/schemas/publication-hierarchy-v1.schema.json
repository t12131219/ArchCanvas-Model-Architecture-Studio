{
  "$defs": {
    "NodeKind": {
      "enum": [
        "module_container",
        "operator",
        "opaque_composite",
        "tensor_value",
        "merge_event",
        "fanout_relation",
        "condition_control",
        "state",
        "repeat",
        "parameter_share",
        "input_output",
        "reference_only"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "PublicationHierarchyNode": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "canonical_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Canonical Node Ids",
          "type": "array"
        },
        "depth": {
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "hierarchy_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Hierarchy Node Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parent_hierarchy_node_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Hierarchy Node Id"
        },
        "semantic_name": {
          "minLength": 1,
          "title": "Semantic Name",
          "type": "string"
        }
      },
      "required": [
        "hierarchy_node_id",
        "semantic_name",
        "kind",
        "depth"
      ],
      "title": "PublicationHierarchyNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Architecture Id",
      "type": "string"
    },
    "canonical_edge_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Edge Ids",
      "type": "array"
    },
    "canonical_node_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Canonical Node Ids",
      "type": "array"
    },
    "canonical_port_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Port Ids",
      "type": "array"
    },
    "canonical_tensor_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Tensor Ids",
      "type": "array"
    },
    "hierarchy_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Hierarchy Id",
      "type": "string"
    },
    "max_depth": {
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/PublicationHierarchyNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "root_node_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Root Node Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "hierarchy_id",
    "architecture_id",
    "root_node_id",
    "nodes",
    "max_depth",
    "canonical_node_ids"
  ],
  "title": "PublicationHierarchy",
  "type": "object"
}
