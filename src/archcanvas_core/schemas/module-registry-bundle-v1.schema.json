{
  "$defs": {
    "ModuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "codegen_rule_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codegen Rule Id"
        },
        "cost_rule_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Rule Id"
        },
        "definition_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "detail_template_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail Template Id"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "glyph_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Glyph Id",
          "type": "string"
        },
        "parameter_schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Parameter Schema Version",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterContract"
          },
          "title": "Parameters",
          "type": "array"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortContract"
          },
          "minItems": 1,
          "title": "Ports",
          "type": "array"
        },
        "qualified_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Qualified Names",
          "type": "array"
        },
        "semantic_kind": {
          "minLength": 1,
          "title": "Semantic Kind",
          "type": "string"
        },
        "shape_rule_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape Rule Id"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "version",
        "digest",
        "semantic_kind",
        "qualified_names",
        "ports",
        "glyph_id"
      ],
      "title": "ModuleDefinition",
      "type": "object"
    },
    "ParameterContract": {
      "additionalProperties": false,
      "properties": {
        "affects": {
          "items": {
            "enum": [
              "ports",
              "shape",
              "cost",
              "code",
              "visual"
            ],
            "type": "string"
          },
          "title": "Affects",
          "type": "array"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "editability": {
          "default": "editable",
          "enum": [
            "editable",
            "source-readonly",
            "derived-readonly"
          ],
          "title": "Editability",
          "type": "string"
        },
        "parameter_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Parameter Id",
          "type": "string"
        },
        "positional_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positional Index"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "value_type": {
          "default": "any",
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "shape",
            "any"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "parameter_id"
      ],
      "title": "ParameterContract",
      "type": "object"
    },
    "PortContract": {
      "additionalProperties": false,
      "properties": {
        "accepted_relations": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Relations",
          "type": "array"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "max_connections": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "const": "many",
              "type": "string"
            }
          ],
          "default": 1,
          "title": "Max Connections"
        },
        "min_connections": {
          "default": 1,
          "minimum": 0,
          "title": "Min Connections",
          "type": "integer"
        },
        "ordering": {
          "default": "ordered",
          "enum": [
            "ordered",
            "unordered"
          ],
          "title": "Ordering",
          "type": "string"
        },
        "port_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Port Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "tensor_layouts": {
          "items": {
            "enum": [
              "NCHW",
              "NHWC",
              "sequence",
              "scalar",
              "any"
            ],
            "type": "string"
          },
          "title": "Tensor Layouts",
          "type": "array"
        },
        "tensor_ranks": {
          "items": {
            "type": "integer"
          },
          "title": "Tensor Ranks",
          "type": "array"
        }
      },
      "required": [
        "port_id",
        "direction"
      ],
      "title": "PortContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Bundle Id",
      "type": "string"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/ModuleDefinition"
      },
      "minItems": 1,
      "title": "Definitions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "bundle_digest",
    "definitions"
  ],
  "title": "ModuleRegistryBundle",
  "type": "object"
}
