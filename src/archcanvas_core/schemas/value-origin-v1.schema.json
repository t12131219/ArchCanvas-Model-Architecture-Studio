{
  "$defs": {
    "ValueOriginKind": {
      "enum": [
        "constructor-literal",
        "module-field",
        "config-key",
        "dataclass-field",
        "function-default",
        "cli-argument",
        "registry-default",
        "factory-result",
        "computed-expression",
        "runtime-only"
      ],
      "title": "ValueOriginKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "enum": [
        "exact",
        "conditional",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "config_key_path": {
      "items": {
        "type": "string"
      },
      "title": "Config Key Path",
      "type": "array"
    },
    "config_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Path"
    },
    "editability": {
      "enum": [
        "direct",
        "adapter-required",
        "readonly"
      ],
      "title": "Editability",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/ValueOriginKind"
    },
    "origin_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Origin Id",
      "type": "string"
    },
    "source_anchor_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Source Anchor Ids",
      "type": "array"
    }
  },
  "required": [
    "origin_id",
    "kind",
    "confidence",
    "editability"
  ],
  "title": "ValueOrigin",
  "type": "object"
}
