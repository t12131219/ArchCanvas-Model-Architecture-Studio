{
  "$defs": {
    "CapabilityStatus": {
      "enum": [
        "verified",
        "experimental",
        "partial",
        "unavailable"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "FrameworkAdapterCapabilityV2": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/FrameworkFormCapabilityV2"
          },
          "minItems": 1,
          "title": "Forms",
          "type": "array"
        },
        "framework": {
          "enum": [
            "pytorch",
            "keras",
            "jax",
            "onnx",
            "python"
          ],
          "title": "Framework",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "required_packages": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Required Packages",
          "type": "object"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        }
      },
      "required": [
        "adapter_id",
        "framework",
        "adapter_version",
        "status",
        "forms"
      ],
      "title": "FrameworkAdapterCapabilityV2",
      "type": "object"
    },
    "FrameworkFormCapabilityV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_commit": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "code_generation": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "form_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Form Id",
          "type": "string"
        },
        "form_name": {
          "minLength": 1,
          "title": "Form Name",
          "type": "string"
        },
        "framework": {
          "enum": [
            "pytorch",
            "keras",
            "jax",
            "onnx",
            "python"
          ],
          "title": "Framework",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "parameter_transaction": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "runtime_evidence": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "static_analysis": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "structural_transaction": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "supported_targets": {
          "items": {
            "type": "string"
          },
          "title": "Supported Targets",
          "type": "array"
        },
        "verified_fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Verified Fixtures",
          "type": "array"
        }
      },
      "required": [
        "form_id",
        "form_name",
        "framework",
        "static_analysis",
        "runtime_evidence",
        "parameter_transaction",
        "structural_transaction",
        "code_generation",
        "artifact_commit"
      ],
      "title": "FrameworkFormCapabilityV2",
      "type": "object"
    },
    "HostSupport": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "enum": [
            "codex-local",
            "claude-code-local",
            "claude-api",
            "claude.ai"
          ],
          "title": "Host",
          "type": "string"
        },
        "install_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Install Target"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "enum": [
            "verified",
            "installer-tested",
            "unverified",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "host",
        "status"
      ],
      "title": "HostSupport",
      "type": "object"
    },
    "PlatformSupport": {
      "additionalProperties": false,
      "properties": {
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ],
          "title": "Platform",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "ci-configured",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "status"
      ],
      "title": "PlatformSupport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapters": {
      "items": {
        "$ref": "#/$defs/FrameworkAdapterCapabilityV2"
      },
      "minItems": 1,
      "title": "Adapters",
      "type": "array"
    },
    "hosts": {
      "items": {
        "$ref": "#/$defs/HostSupport"
      },
      "minItems": 1,
      "title": "Hosts",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "offline_runtime_network_required": {
      "const": false,
      "default": false,
      "title": "Offline Runtime Network Required",
      "type": "boolean"
    },
    "platforms": {
      "items": {
        "$ref": "#/$defs/PlatformSupport"
      },
      "minItems": 1,
      "title": "Platforms",
      "type": "array"
    },
    "release": {
      "minLength": 1,
      "title": "Release",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "release",
    "adapters",
    "hosts",
    "platforms"
  ],
  "title": "ReleaseSupportMatrixV2",
  "type": "object"
}
