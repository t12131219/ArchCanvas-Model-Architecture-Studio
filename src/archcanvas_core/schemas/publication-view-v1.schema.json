{
  "$defs": {
    "EdgeType": {
      "enum": [
        "main",
        "residual",
        "skip",
        "memory",
        "state",
        "condition",
        "routing",
        "parameter-share",
        "training-only"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "NodeKind": {
      "enum": [
        "module_container",
        "operator",
        "opaque_composite",
        "tensor_value",
        "merge_event",
        "fanout_relation",
        "condition_control",
        "state",
        "repeat",
        "parameter_share",
        "input_output",
        "reference_only"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "PublicationEdge": {
      "additionalProperties": false,
      "properties": {
        "canonical_edge_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Canonical Edge Ids",
          "type": "array"
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "source_view_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Source View Node Id",
          "type": "string"
        },
        "symbolic_shape": {
          "minLength": 1,
          "title": "Symbolic Shape",
          "type": "string"
        },
        "target_view_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target View Node Id",
          "type": "string"
        },
        "view_edge_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "View Edge Id",
          "type": "string"
        },
        "visual_relation": {
          "$ref": "#/$defs/VisualRelation",
          "default": "sequence"
        }
      },
      "required": [
        "view_edge_id",
        "canonical_edge_ids",
        "source_view_node_id",
        "target_view_node_id",
        "role",
        "edge_type",
        "symbolic_shape"
      ],
      "title": "PublicationEdge",
      "type": "object"
    },
    "PublicationNode": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "boundary_roles": {
          "items": {
            "type": "string"
          },
          "title": "Boundary Roles",
          "type": "array"
        },
        "canonical_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Canonical Node Ids",
          "type": "array"
        },
        "collapsed": {
          "title": "Collapsed",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parent_view_node_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent View Node Id"
        },
        "semantic_name": {
          "minLength": 1,
          "title": "Semantic Name",
          "type": "string"
        },
        "view_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "View Node Id",
          "type": "string"
        }
      },
      "required": [
        "view_node_id",
        "semantic_name",
        "kind",
        "collapsed"
      ],
      "title": "PublicationNode",
      "type": "object"
    },
    "VisualRelation": {
      "description": "Evidence-derived diagram grammar layered over canonical edge semantics.",
      "enum": [
        "sequence",
        "parallel-branch",
        "merge",
        "residual",
        "shape-transform",
        "memory-reference",
        "condition",
        "routing",
        "state-update",
        "parameter-share",
        "training-only"
      ],
      "title": "VisualRelation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Architecture Id",
      "type": "string"
    },
    "canonical_edge_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Edge Ids",
      "type": "array"
    },
    "canonical_node_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Canonical Node Ids",
      "type": "array"
    },
    "canonical_port_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Port Ids",
      "type": "array"
    },
    "canonical_tensor_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Canonical Tensor Ids",
      "type": "array"
    },
    "collapsed_edge_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Collapsed Edge Ids",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/PublicationEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "expanded_node_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Expanded Node Ids",
      "type": "array"
    },
    "frontier_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Frontier Digest",
      "type": "string"
    },
    "fully_expanded": {
      "default": false,
      "title": "Fully Expanded",
      "type": "boolean"
    },
    "hierarchy_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Hierarchy Id",
      "type": "string"
    },
    "layout_family": {
      "enum": [
        "dual-lane",
        "single-lane",
        "dual-backbone",
        "multiscale-ladder",
        "generic-dag"
      ],
      "title": "Layout Family",
      "type": "string"
    },
    "max_depth": {
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/PublicationNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "non_executable_duplicates": {
      "default": false,
      "title": "Non Executable Duplicates",
      "type": "boolean"
    },
    "projection_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Projection Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "view_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "View Id",
      "type": "string"
    },
    "visible_depth": {
      "minimum": 0,
      "title": "Visible Depth",
      "type": "integer"
    }
  },
  "required": [
    "view_id",
    "architecture_id",
    "hierarchy_id",
    "projection_id",
    "frontier_digest",
    "visible_depth",
    "max_depth",
    "name",
    "layout_family",
    "nodes",
    "canonical_node_ids"
  ],
  "title": "PublicationView",
  "type": "object"
}
