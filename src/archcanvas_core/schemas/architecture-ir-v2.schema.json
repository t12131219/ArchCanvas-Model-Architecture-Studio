      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "call_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Call Id",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "control_region_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Control Region Id",
          "type": "string"
        },
        "definition_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefinitionRef"
            },
