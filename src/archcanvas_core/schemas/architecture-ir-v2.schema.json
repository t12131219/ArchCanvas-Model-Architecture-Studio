          "type": "array"
        },
        "parent_module_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Parent Module Id",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "parent_module_id",
        "control_region_id",
        "anchor",
        "confidence"
