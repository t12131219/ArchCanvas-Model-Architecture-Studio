{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "FactDelta": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "kind": {
          "enum": [
            "node",
            "edge",
            "tensor",
            "port",
            "fanout",
            "repeat",
            "config-predicate",
            "evidence",
            "unresolved"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "kind"
      ],
      "title": "FactDelta",
      "type": "object"
    },
    "FileChange": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "python",
            "json",
            "onnx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "before_sha256",
        "after_sha256"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^[A-Z][A-Za-z0-9_-]+$",
          "title": "Gate",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "message"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "GraphDelta": {
      "additionalProperties": false,
      "properties": {
        "added_config_predicates": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Config Predicates",
          "type": "array"
        },
        "added_edges": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Edges",
          "type": "array"
        },
        "added_fanouts": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Fanouts",
          "type": "array"
        },
        "added_nodes": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Nodes",
          "type": "array"
        },
        "added_ports": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Ports",
          "type": "array"
        },
        "added_tensors": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Added Tensors",
          "type": "array"
        },
        "changed_config_predicates": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Config Predicates",
          "type": "array"
        },
        "changed_edges": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Edges",
          "type": "array"
        },
        "changed_fanouts": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Fanouts",
          "type": "array"
        },
        "changed_nodes": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Nodes",
          "type": "array"
        },
        "changed_parameters": {
          "items": {
            "$ref": "#/$defs/ParameterDelta"
          },
          "title": "Changed Parameters",
          "type": "array"
        },
        "changed_ports": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Ports",
          "type": "array"
        },
        "changed_repeats": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Repeats",
          "type": "array"
        },
        "changed_shapes": {
          "items": {
            "$ref": "#/$defs/ShapeDelta"
          },
          "title": "Changed Shapes",
          "type": "array"
        },
        "changed_sharing": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Sharing",
          "type": "array"
        },
        "changed_tensors": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Changed Tensors",
          "type": "array"
        },
        "evidence_anchor_changes": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Anchor Changes",
          "type": "array"
        },
        "fact_changes": {
          "items": {
            "$ref": "#/$defs/FactDelta"
          },
          "title": "Fact Changes",
          "type": "array"
        },
        "removed_config_predicates": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Config Predicates",
          "type": "array"
        },
        "removed_edges": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Edges",
          "type": "array"
        },
        "removed_fanouts": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Fanouts",
          "type": "array"
        },
        "removed_nodes": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Nodes",
          "type": "array"
        },
        "removed_ports": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Ports",
          "type": "array"
        },
        "removed_tensors": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Removed Tensors",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unresolved_changes": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Changes",
          "type": "array"
        }
      },
      "title": "GraphDelta",
      "type": "object"
    },
    "ParameterDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After"
        },
        "before": {
          "title": "Before"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "parameter_name": {
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        },
        "source_expression": {
          "minLength": 1,
          "title": "Source Expression",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter_name",
        "before",
        "after",
        "source_expression"
      ],
      "title": "ParameterDelta",
      "type": "object"
    },
    "SemanticParameterPatch": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "new_value": {
          "title": "New Value"
        },
        "operation": {
          "const": "set_parameter",
          "default": "set_parameter",
          "title": "Operation",
          "type": "string"
        },
        "parameter_name": {
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Patch Id",
          "type": "string"
        },
        "runtime_input_spec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Input Spec"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target Node Id",
          "type": "string"
        },
        "targeted_tests": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Targeted Tests",
          "type": "array"
        }
      },
      "required": [
        "patch_id",
        "artifact_path",
        "target_node_id",
        "parameter_name",
        "new_value"
      ],
      "title": "SemanticParameterPatch",
      "type": "object"
    },
    "SemanticStructuralPatch": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "operation": {
          "enum": [
            "replace_activation",
            "insert_layer_norm"
          ],
          "title": "Operation",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "patch_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Patch Id",
          "type": "string"
        },
        "runtime_input_spec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Input Spec"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target Node Id",
          "type": "string"
        },
        "targeted_tests": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Targeted Tests",
          "type": "array"
        }
      },
      "required": [
        "patch_id",
        "operation",
        "artifact_path",
        "target_node_id"
      ],
      "title": "SemanticStructuralPatch",
      "type": "object"
    },
    "ShapeDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "before",
        "after"
      ],
      "title": "ShapeDelta",
      "type": "object"
    },
    "TransactionState": {
      "enum": [
        "draft",
        "planned",
        "prepared",
        "source-validated",
        "reanalyzed",
        "graph-delta-validated",
        "tests-passed",
        "review-ready",
        "committed",
        "discarded",
        "failed"
      ],
      "title": "TransactionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "default": "0.1.0",
      "title": "Adapter Version",
      "type": "string"
    },
    "anchor_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Anchor Fingerprint",
      "type": "string"
    },
    "artifact_kind": {
      "default": "source-artifact",
      "enum": [
        "source-artifact",
        "model-artifact"
      ],
      "title": "Artifact Kind",
      "type": "string"
    },
    "artifact_path": {
      "minLength": 1,
      "title": "Artifact Path",
      "type": "string"
    },
    "base_revision": {
      "minLength": 1,
      "title": "Base Revision",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "expected_delta": {
      "$ref": "#/$defs/GraphDelta"
    },
    "file_changes": {
      "items": {
        "$ref": "#/$defs/FileChange"
      },
      "minItems": 1,
      "title": "File Changes",
      "type": "array"
    },
    "framework": {
      "default": "pytorch",
      "enum": [
        "pytorch",
        "keras",
        "jax",
        "onnx"
      ],
      "title": "Framework",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "observed_delta": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphDelta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "original_project_root": {
      "minLength": 1,
      "title": "Original Project Root",
      "type": "string"
    },
    "reanalysis_route": {
      "default": "analyze_with_adapter",
      "title": "Reanalysis Route",
      "type": "string"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticParameterPatch"
        },
        {
          "$ref": "#/$defs/SemanticStructuralPatch"
        }
      ],
      "title": "Request"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_diff": {
      "title": "Source Diff",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TransactionState"
    },
    "state_history": {
      "items": {
        "$ref": "#/$defs/TransactionState"
      },
      "title": "State History",
      "type": "array"
    },
    "temporary_project_root": {
      "minLength": 1,
      "title": "Temporary Project Root",
      "type": "string"
    },
    "test_results": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Test Results",
      "type": "array"
    },
    "transaction_adapter_id": {
      "default": "transaction:pytorch-source-v1",
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Adapter Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    },
    "validators": {
      "items": {
        "type": "string"
      },
      "title": "Validators",
      "type": "array"
    },
    "workspace": {
      "minLength": 1,
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "state",
    "request",
    "created_at",
    "workspace",
    "original_project_root",
    "temporary_project_root",
    "artifact_path",
    "source_snapshot_id",
    "base_revision",
    "anchor_fingerprint",
    "file_changes",
    "source_diff",
    "expected_delta"
  ],
  "title": "SourceTransaction",
  "type": "object"
}
