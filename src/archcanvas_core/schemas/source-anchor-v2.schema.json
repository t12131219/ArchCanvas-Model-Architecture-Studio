{
  "$defs": {
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_column": {
          "default": 0,
          "minimum": 0,
          "title": "End Column",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_column": {
          "default": 0,
          "minimum": 0,
          "title": "Start Column",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blob_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Blob Digest",
      "type": "string"
    },
    "byte_length": {
      "minimum": 0,
      "title": "Byte Length",
      "type": "integer"
    },
    "byte_start": {
      "minimum": 0,
      "title": "Byte Start",
      "type": "integer"
    },
    "cst_node_kind": {
      "minLength": 1,
      "title": "Cst Node Kind",
      "type": "string"
    },
    "line_span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "logical_path": {
      "title": "Logical Path",
      "type": "string"
    },
    "parent_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Fingerprint"
    },
    "qualified_symbol": {
      "minLength": 1,
      "title": "Qualified Symbol",
      "type": "string"
    },
    "semantic_role": {
      "minLength": 1,
      "title": "Semantic Role",
      "type": "string"
    },
    "subtree_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Subtree Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "logical_path",
    "blob_digest",
    "byte_start",
    "byte_length",
    "line_span",
    "qualified_symbol",
    "cst_node_kind",
    "semantic_role",
    "subtree_fingerprint"
  ],
  "title": "SourceAnchor",
  "type": "object"
}
