{
  "$defs": {
    "ExcludedSource": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "excluded-pattern",
            "unsupported-kind",
            "symlink",
            "path-escape",
            "file-too-large",
            "budget-exhausted",
            "decode-error",
            "shadowed"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "logical_path",
        "reason"
      ],
      "title": "ExcludedSource",
      "type": "object"
    },
    "SourceBlobRef": {
      "additionalProperties": false,
      "properties": {
        "blob_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Blob Ref",
          "type": "string"
        },
        "encoding": {
          "minLength": 1,
          "title": "Encoding",
          "type": "string"
        },
        "file_kind": {
          "enum": [
            "python",
            "stub",
            "config",
            "project-metadata"
          ],
          "title": "File Kind",
          "type": "string"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "logical_path",
        "sha256",
        "blob_ref",
        "size",
        "encoding",
        "file_kind"
      ],
      "title": "SourceBlobRef",
      "type": "object"
    },
    "SourceRootSpec": {
      "additionalProperties": false,
      "properties": {
        "logical_prefix": {
          "default": "",
          "title": "Logical Prefix",
          "type": "string"
        },
        "precedence": {
          "default": 0,
          "minimum": 0,
          "title": "Precedence",
          "type": "integer"
        },
        "relative_path": {
          "default": ".",
          "title": "Relative Path",
          "type": "string"
        }
      },
      "title": "SourceRootSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Corpus Id",
      "type": "string"
    },
    "excluded": {
      "items": {
        "$ref": "#/$defs/ExcludedSource"
      },
      "title": "Excluded",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SourceBlobRef"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_corpus_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Corpus Digest",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "$ref": "#/$defs/SourceRootSpec"
      },
      "minItems": 1,
      "title": "Source Roots",
      "type": "array"
    },
    "vcs_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vcs Revision"
    }
  },
  "required": [
    "corpus_id",
    "source_corpus_digest",
    "files",
    "source_roots"
  ],
  "title": "SourceCorpus",
  "type": "object"
}
