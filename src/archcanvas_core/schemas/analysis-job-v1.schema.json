{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "stale"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "input_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Job Id",
      "type": "string"
    },
    "profile": {
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "progress": {
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    }
  },
  "required": [
    "job_id",
    "project_id",
    "generation",
    "input_fingerprint",
    "profile",
    "state",
    "progress"
  ],
  "title": "AnalysisJob",
  "type": "object"
}
