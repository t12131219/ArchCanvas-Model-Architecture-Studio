{
  "$defs": {
    "AffectedObjectReviewBinding": {
      "additionalProperties": false,
      "properties": {
        "affected_object_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Object Ids",
          "type": "array"
        },
        "decision": {
          "enum": [
            "pending",
            "confirmed",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "parameter_sharing_group_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Parameter Sharing Group Ids",
          "type": "array"
        },
        "review_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_generation": {
          "minimum": 1,
          "title": "Reviewed Generation",
          "type": "integer"
        },
        "source_anchor_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Anchor Ids",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "affected_object_ids",
        "decision",
        "reviewed_generation"
      ],
      "title": "AffectedObjectReviewBinding",
      "type": "object"
    },
    "EditTargetScope": {
      "enum": [
        "definition",
        "module-instance",
        "call-site",
        "repeat-template",
        "config-value",
        "parameter-sharing-group",
        "all-shared-uses"
      ],
      "title": "EditTargetScope",
      "type": "string"
    },
    "ValueOrigin": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "exact",
            "conditional",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "config_key_path": {
          "items": {
            "type": "string"
          },
          "title": "Config Key Path",
          "type": "array"
        },
        "config_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Path"
        },
        "editability": {
          "enum": [
            "direct",
            "adapter-required",
            "readonly"
          ],
          "title": "Editability",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ValueOriginKind"
        },
        "origin_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Origin Id",
          "type": "string"
        },
        "source_anchor_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Anchor Ids",
          "type": "array"
        }
      },
      "required": [
        "origin_id",
        "kind",
        "confidence",
        "editability"
      ],
      "title": "ValueOrigin",
      "type": "object"
    },
    "ValueOriginKind": {
      "enum": [
        "constructor-literal",
        "module-field",
        "config-key",
        "dataclass-field",
        "function-default",
        "cli-argument",
        "registry-default",
        "factory-result",
        "computed-expression",
        "runtime-only"
      ],
      "title": "ValueOriginKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_object_review": {
      "$ref": "#/$defs/AffectedObjectReviewBinding"
    },
    "base_exact_ir_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Exact Ir Digest",
      "type": "string"
    },
    "base_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Source Digest",
      "type": "string"
    },
    "edit_target_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditTargetScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "form_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Form Id",
      "type": "string"
    },
    "framework": {
      "enum": [
        "pytorch",
        "keras",
        "jax",
        "onnx",
        "python"
      ],
      "title": "Framework",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Intent Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "create-node",
        "delete-node",
        "set-parameter",
        "replace-operation",
        "insert-normalization",
        "connect-ports",
        "disconnect-edge",
        "add-residual",
        "concat-inputs",
        "edit-source-buffer"
      ],
      "title": "Operation",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "project_generation": {
      "minimum": 1,
      "title": "Project Generation",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Ids",
      "type": "array"
    },
    "value_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValueOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "intent_id",
    "project_id",
    "project_generation",
    "base_source_digest",
    "base_exact_ir_digest",
    "framework",
    "form_id",
    "operation",
    "target_ids",
    "affected_object_review"
  ],
  "title": "SemanticIntentV2",
  "type": "object"
}
