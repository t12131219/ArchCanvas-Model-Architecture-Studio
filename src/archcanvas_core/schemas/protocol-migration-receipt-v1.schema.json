{
  "additionalProperties": false,
  "properties": {
    "from_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "From Version",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "migration_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Migration Id"
    },
    "output_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Digest",
      "type": "string"
    },
    "protocol": {
      "minLength": 1,
      "title": "Protocol",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "current",
        "compatible-minor",
        "migrated"
      ],
      "title": "Status",
      "type": "string"
    },
    "to_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "To Version",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "protocol",
    "from_version",
    "to_version",
    "status",
    "input_digest",
    "output_digest"
  ],
  "title": "ProtocolMigrationReceipt",
  "type": "object"
}
