{
  "$defs": {
    "EditTargetScope": {
      "enum": [
        "definition",
        "module-instance",
        "call-site",
        "repeat-template",
        "config-value",
        "parameter-sharing-group",
        "all-shared-uses"
      ],
      "title": "EditTargetScope",
      "type": "string"
    },
    "ValueOrigin": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "exact",
            "conditional",
            "unknown"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "config_key_path": {
          "items": {
            "type": "string"
          },
          "title": "Config Key Path",
          "type": "array"
        },
        "config_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Path"
        },
        "editability": {
          "enum": [
            "direct",
            "adapter-required",
            "readonly"
          ],
          "title": "Editability",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ValueOriginKind"
        },
        "origin_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Origin Id",
          "type": "string"
        },
        "source_anchor_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Anchor Ids",
          "type": "array"
        }
      },
      "required": [
        "origin_id",
        "kind",
        "confidence",
        "editability"
      ],
      "title": "ValueOrigin",
      "type": "object"
    },
    "ValueOriginKind": {
      "enum": [
        "constructor-literal",
        "module-field",
        "config-key",
        "dataclass-field",
        "function-default",
        "cli-argument",
        "registry-default",
        "factory-result",
        "computed-expression",
        "runtime-only"
      ],
      "title": "ValueOriginKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_canonical_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Affected Canonical Ids",
      "type": "array"
    },
    "allowed_scopes": {
      "items": {
        "$ref": "#/$defs/EditTargetScope"
      },
      "title": "Allowed Scopes",
      "type": "array"
    },
    "blocking_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocking Reason"
    },
    "context_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Context Id",
      "type": "string"
    },
    "current_value": {
      "default": null,
      "title": "Current Value"
    },
    "default_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditTargetScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameter_name": {
      "minLength": 1,
      "title": "Parameter Name",
      "type": "string"
    },
    "target_node_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Target Node Id",
      "type": "string"
    },
    "value_origin": {
      "$ref": "#/$defs/ValueOrigin"
    }
  },
  "required": [
    "context_id",
    "target_node_id",
    "parameter_name",
    "value_origin"
  ],
  "title": "ParameterEditContext",
  "type": "object"
}
