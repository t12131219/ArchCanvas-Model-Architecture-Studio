{
  "$defs": {
    "DiscoveryBudget": {
      "additionalProperties": false,
      "properties": {
        "max_file_bytes": {
          "default": 2097152,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_files": {
          "default": 10000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 536870912,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        }
      },
      "title": "DiscoveryBudget",
      "type": "object"
    },
    "SourceRootSpec": {
      "additionalProperties": false,
      "properties": {
        "logical_prefix": {
          "default": "",
          "title": "Logical Prefix",
          "type": "string"
        },
        "precedence": {
          "default": 0,
          "minimum": 0,
          "title": "Precedence",
          "type": "integer"
        },
        "relative_path": {
          "default": ".",
          "title": "Relative Path",
          "type": "string"
        }
      },
      "title": "SourceRootSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_paths": {
      "items": {
        "type": "string"
      },
      "title": "Config Paths",
      "type": "array"
    },
    "discovery_budget": {
      "$ref": "#/$defs/DiscoveryBudget"
    },
    "exclude_globs": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Globs",
      "type": "array"
    },
    "include_globs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Include Globs",
      "type": "array"
    },
    "namespace_package_policy": {
      "default": "enabled",
      "enum": [
        "enabled",
        "disabled"
      ],
      "title": "Namespace Package Policy",
      "type": "string"
    },
    "platform_target": {
      "default": "all",
      "minLength": 1,
      "title": "Platform Target",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "project_root_hint": {
      "minLength": 1,
      "title": "Project Root Hint",
      "type": "string"
    },
    "python_target": {
      "default": "3.11",
      "minLength": 1,
      "title": "Python Target",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "$ref": "#/$defs/SourceRootSpec"
      },
      "minItems": 1,
      "title": "Source Roots",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "project_root_hint",
    "source_roots",
    "include_globs"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
