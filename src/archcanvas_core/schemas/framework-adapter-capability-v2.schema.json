{
  "$defs": {
    "CapabilityStatus": {
      "enum": [
        "verified",
        "experimental",
        "partial",
        "unavailable"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "FrameworkFormCapabilityV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_commit": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "code_generation": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "form_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Form Id",
          "type": "string"
        },
        "form_name": {
          "minLength": 1,
          "title": "Form Name",
          "type": "string"
        },
        "framework": {
          "enum": [
            "pytorch",
            "keras",
            "jax",
            "onnx",
            "python"
          ],
          "title": "Framework",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "parameter_transaction": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "runtime_evidence": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "static_analysis": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "structural_transaction": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "supported_targets": {
          "items": {
            "type": "string"
          },
          "title": "Supported Targets",
          "type": "array"
        },
        "verified_fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Verified Fixtures",
          "type": "array"
        }
      },
      "required": [
        "form_id",
        "form_name",
        "framework",
        "static_analysis",
        "runtime_evidence",
        "parameter_transaction",
        "structural_transaction",
        "code_generation",
        "artifact_commit"
      ],
      "title": "FrameworkFormCapabilityV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "forms": {
      "items": {
        "$ref": "#/$defs/FrameworkFormCapabilityV2"
      },
      "minItems": 1,
      "title": "Forms",
      "type": "array"
    },
    "framework": {
      "enum": [
        "pytorch",
        "keras",
        "jax",
        "onnx",
        "python"
      ],
      "title": "Framework",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "required_packages": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Required Packages",
      "type": "object"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CapabilityStatus"
    }
  },
  "required": [
    "adapter_id",
    "framework",
    "adapter_version",
    "status",
    "forms"
  ],
  "title": "FrameworkAdapterCapabilityV2",
  "type": "object"
}
