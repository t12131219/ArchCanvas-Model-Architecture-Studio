{
  "$defs": {
    "FactDelta": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "kind": {
          "enum": [
            "node",
            "edge",
            "tensor",
            "port",
            "fanout",
            "repeat",
            "config-predicate",
            "evidence",
            "unresolved"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "kind"
      ],
      "title": "FactDelta",
      "type": "object"
    },
    "ParameterDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After"
        },
        "before": {
          "title": "Before"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "parameter_name": {
          "minLength": 1,
          "title": "Parameter Name",
          "type": "string"
        },
        "source_expression": {
          "minLength": 1,
          "title": "Source Expression",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter_name",
        "before",
        "after",
        "source_expression"
      ],
      "title": "ParameterDelta",
      "type": "object"
    },
    "ShapeDelta": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "before",
        "after"
      ],
      "title": "ShapeDelta",
      "type": "object"
    }
  },
