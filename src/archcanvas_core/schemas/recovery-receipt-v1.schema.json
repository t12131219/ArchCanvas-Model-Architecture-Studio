{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "TransactionJournalState": {
      "enum": [
        "prepared",
        "verified",
        "commit-intent-recorded",
        "replacing-files",
        "post-commit-validating",
        "committed",
        "rollback-required",
        "rolled-back",
        "recovery-failed",
        "discarded"
      ],
      "title": "TransactionJournalState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "after_state_proven": {
      "title": "After State Proven",
      "type": "boolean"
    },
    "before_state_proven": {
      "title": "Before State Proven",
      "type": "boolean"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "journal_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Journal Id",
      "type": "string"
    },
    "journal_state": {
      "$ref": "#/$defs/TransactionJournalState"
    },
    "outcome": {
      "enum": [
        "discarded",
        "committed",
        "rolled-back",
        "recovery-failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "recovered_files": {
      "items": {
        "type": "string"
      },
      "title": "Recovered Files",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_writes": {
      "title": "Source Writes",
      "type": "boolean"
    },
    "transaction_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "transaction_id",
    "journal_id",
    "outcome",
    "journal_state",
    "before_state_proven",
    "after_state_proven",
    "source_writes",
    "created_at"
  ],
  "title": "RecoveryReceipt",
  "type": "object"
}
