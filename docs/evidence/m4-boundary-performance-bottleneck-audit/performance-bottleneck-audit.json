      "id": "iframe_and_scheduler",
      "status": "strong_external_confound",
      "files": [
        "scripts/m4_input_harness.py:18-43",
        "scripts/m4_input_support/control.mjs:1-70"
      ],
      "detail": "measurement harness embeds Studio in an iframe; an independent control page with no React/SVG/model shows the same approximately 2Hz cadence and 1000ms EventTiming under one window."
    }
  ],
  "interpretation": {
    "twoHzGaps": "More consistent with browser/host scheduling or surface throttling than with this product alone: simple-control-background is ~1.95Hz with p95 983.4ms and max EventTiming 1000ms while visible/focused; product raw is ~1.98Hz with p95 983.4ms and 992-2024ms EventTiming. Another simple-control window reaches ~19.18Hz, showing the cadence is not invariant.",
    "productRisk": "Product remains performance-risky under an ordinary 60Hz presented environment: full expanded drag frame path is approximately 3.86ms scene + 4.11ms SVG in standalone Node plus DOM parse/layout not represented there; browser stress reports max long task 101ms and expand/collapse proxies around 1.0/2.0s under throttled window. These long tasks are real product work but do not explain every 1s gap.",
    "observerRisk": "Observer adds DOM reads and same-origin iframe overhead; measured callback/self costs are too small to establish that it caused the one-second cadence, and the simple control reproduces the cadence without Studio.",
    "paintStatus": "rAF timestamps, geometry and EventTiming do not prove presented compositor frames or input-to-paint; presented paint/FPS remains unverified.",
    "causeStatus": "No unique CPU/scheduler cause is proven; no claim that product is fast or passes M4."
  },
  "safeNextStep": {
    "doNotChangeYet": "Do not change source/build solely from the 2Hz receipt. First separate scheduler from product cost in one fixed visible session.",
    "diagnosticDesign": [
      "Run product and no-React/SVG/model control in the same browser surface/session with continuously recorded visibility/focus and, if available, presented-frame trace; retain both raw windows.",
      "Record product marks around prepareMovePreview, buildScene, renderSvg, React commit and DOM commit separately in a disposable diagnostics copy; keep source/IR/frontier/Canvas exact.",
      "Use a normal 60Hz-capable window before interpreting p95; EventTiming matches remain discrete only and rAF remains cadence-only without presented trace."
    ],
    "minimalOptimizationCandidate": {
      "name": "memoize_architecture_indices_for_buildScene",
      "risk": "low-to-medium",
      "why": "Cache immutable architecture-derived byId/roots/authoredOrder/auxiliaryInputs/sourceFacts/canonicalEdgeIndex/parent chains by architecture identity; output bytes and document semantics remain unchanged while repeated preview builds avoid repeated map/filter setup.",
      "guardrails": [
        "WeakMap keyed by Architecture; invalidate on architecture identity change or sourceDigest/irDigest mismatch.",
        "Add byte-for-byte Scene/renderSvg tests across DenseStress300 collapsed/expanded, page preset, aliases, edge/node styles, annotations, frontier layout and undo/redo.",
        "Run standalone core benchmark plus actual visible browser stress; compare DOM longtasks and any presented trace."
      ],
      "expectedScope": "May reduce CPU work inside each preview build; cannot remove whole-SVG DOM parse cost or prove scheduler cause."
    },
    "higherRiskCandidate": {
      "name": "drag_overlay_or_keyed_incremental_svg",
      "risk": "high",
      "why": "Avoiding full dangerouslySetInnerHTML replacement during preview would address the largest DOM-side cost, but can alter edge routing, ports, hit targets, accessibility and export byte identity. Requires a separate versioned experiment and full matrix regression."
    }
  },
