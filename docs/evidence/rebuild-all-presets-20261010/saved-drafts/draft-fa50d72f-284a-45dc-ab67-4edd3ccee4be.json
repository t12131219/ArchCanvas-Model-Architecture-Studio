"id": "e_5", "source": {"nodeId": "n_5", "portId": "output"}, "target": {"nodeId": "n_7", "portId": "value"}}, {"id": "e_6", "source": {"nodeId": "n_3", "portId": "output"}, "target": {"nodeId": "n_7", "portId": "key_padding_mask"}}, {"id": "e_7", "source": {"nodeId": "n_7", "portId": "output"}, "target": {"nodeId": "n_8", "portId": "input"}}, {"id": "e_8", "source": {"nodeId": "n_8", "portId": "output"}, "target": {"nodeId": "n_9", "portId": "input"}}], "allowUnusedNodes": true, "customModules": [{"schemaVersion": 1, "source": "from torch import nn\nclass MaskedAttention(nn.Module):\n def __init__(self, embed_dim=32, num_heads=4, dropout=0.1, batch_first=True):\n  super().__init__()\n  self.attention=nn.MultiheadAttention(embed_dim,num_heads,dropout=dropout,batch_first=batch_first)\n def forward(self, query, key, value, key_padding_mask):\n  return self.attention(query=query,key=key,value=value,key_padding_mask=key_padding_mask,need_weights=False)\n", "entry": "MaskedAttention", "label": "MaskedAttention", "constructorValues": {"batch_first": true, "dropout": 0.1, "embed_dim": 8, "num_heads": 2}, "kind": "Custom_6f625cf94bc5b82b970bae33", "digest": "6f625cf94bc5b82b970bae33bdc4dbeaaacf49796bd1bd0a59945fd7c46a328a", "sourceDigest": "8ea2dcd005606d3e582f5cc51ed8b29b376c99be78b02802bce213e98b096706", "inputs": [{"id": "query", "name": "query", "positionalOnly": false}, {"id": "key", "name": "key", "positionalOnly": false}, {"id": "value", "name": "value", "positionalOnly": false}, {"id": "key_padding_mask", "name": "key_padding_mask", "positionalOnly": false}], "outputs": [{"id": "output", "name": "output[0]", "path": [{"kind": "index", "index": 0}]}]}]}, "revision": 2}