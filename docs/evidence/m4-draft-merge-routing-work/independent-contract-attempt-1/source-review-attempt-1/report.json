{
  "protocol": "archcanvas-independent-draft-routing-source-review/1",
  "reviewedAt": "2026-10-06T02:47:35.622395+00:00",
  "reviewer": "AI acceptance agent; not human",
  "checks": [
    {
      "id": "SR1",
      "result": true,
      "scope": "Product integration",
      "evidence": "Frozen/current authoring diff is exactly one new import and one replacement of router.batch with draft-only refineDraftRoutes(nodes,requests,router.batch(requests)). Existing edge IDs and return shape retained."
    },
    {
      "id": "SR2",
      "result": true,
      "scope": "47 original rules/docs/Studio source bindings",
      "evidence": "Only original authoring.ts differs. Shared core router, Canvas scene/export code, AuthoringStudio UI and prior formal docs are byte-exact. New independent test and new draftRouting.ts are separate additions."
    },
    {
      "id": "SR3",
      "result": true,
      "scope": "New-module runtime independence",
      "evidence": "Only import is type-only orthogonalRouter.ts within the formal Studio; no failed Temp import, dynamic discovery, fallback, npm install or model execution."
    },
    {
      "id": "SR4",
      "result": true,
      "scope": "Semantic and persistence boundary, source review only",
      "evidence": "New function accepts readonly boxes/requests/results, shallow-copies result records, writes only its result array plus local search arrays, and never assigns node positions, edge/request endpoint identities, schema, draft revision, parameters, file/storage/network state. Test contract independently checks exact caller draft bytes."
    },
    {
      "id": "SR5",
      "result": true,
      "scope": "Endpoint and normal guard",
      "evidence": "Search leads use current original endpoint directions, every final candidate segment is checked against all card bodies and occupied non-family segments, candidate first/last directions must equal original. Coordinate encoding rounds at0.01; independent endpoint tolerance0.025 covers the existing rounding contract. No exact-bit endpoint claim."
    },
    {
      "id": "SR6",
      "result": true,
      "scope": "Family/branch identity",
      "evidence": "Authoring request family tensorId is JSON string [source nodeId,source portId]. Only exact family pairs are excluded from occupied routes; individual per-edge results and mapped IDs remain. No edge merging/dropping/remapping."
    },
    {
      "id": "SR7",
      "result": true,
      "scope": "Bounded work and no destructive budget fallback",
      "evidence": "Separate conflict100000 and clear-geometry250000 check caps; nodes24,edges64,cells16000,expanded-state64000,searches8 caps. Conflict exhaustion before changes returns original result copies; during loop breaks retain prior safe candidates and every remaining old route. Other cap/search failures continue or break without dropping any route."
    },
    {
      "id": "SR8",
      "result": true,
      "scope": "Honest limitation",
      "evidence": "These caps constrain only extra draft refinement. Existing shared-router work is separately bounded. Node/edge limits, search exhaustion, fixed-port nonplanarity or multiple conflicting branches can retain visible crossings; there is no universal crossing-free, minimum-bend, native performance, visual or human claim."
    },
    {
      "id": "SR9",
      "result": true,
      "scope": "Independent tests and old failure relevance",
      "evidence": "Final11 handwritten sensor/fixture checks frozen before final run; old frozen-source baseline7pass4fail; horizontal/vertical hand-drawn planar witnesses pass independent sensors but prescribe no product polyline. Original observer tolerance mistake and relative-import failure retained."
    }
  ],
