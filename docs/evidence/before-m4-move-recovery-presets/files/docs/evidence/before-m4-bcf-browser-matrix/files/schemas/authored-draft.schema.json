{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcanvas.local/schemas/authored-draft.schema.json",
  "title": "Independent authored model draft v1",
  "description": "A draft is separate from source-bound Architecture/CanvasDocument. Runtime validation additionally enforces unique node/edge identities, exact module parameter fields, typed tensor ports, one producer per input, acyclicity, declared shape/dtype consistency and complete generation reachability. No runtime observation is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "id",
    "title",
    "revision",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "mode": {
      "const": "authored-draft"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "parameters",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "Input",
              "Output",
              "Linear",
              "ReLU",
              "GELU",
              "SiLU",
              "Identity",
              "Dropout",
              "Flatten",
              "Conv2d",
              "MaxPool2d",
              "AdaptiveAvgPool2d",
              "BatchNorm2d",
              "LayerNorm",
              "Embedding",
              "Add",
              "Concat"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f]+$"
          },
          "parameters": {
            "type": "object",
            "description": "Module-specific fields and ranges come from /api/authoring/catalog and validate_draft."
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "portId"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "portId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "portId"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "portId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    }
  }
}
