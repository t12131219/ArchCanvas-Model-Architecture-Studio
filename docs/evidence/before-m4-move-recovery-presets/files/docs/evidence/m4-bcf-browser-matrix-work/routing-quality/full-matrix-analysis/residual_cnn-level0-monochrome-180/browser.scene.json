        "path": "model.py",
        "line": 16,
        "endLine": 21,
        "expression": "def forward(self, image):\n        x = self.stem(image)\n        for block in self.blocks:\n            x = block(x)\n        x = self.flatten(self.pool(x))\n        return self.classifier(x)"
      }
