  "authority": "source-structure-only; no execution path, tensor ports, shapes, or source-generation authority",
  "binding": {
    "entry": "model:ChebyKANLinear",
    "method": "forward",
    "methodSpan": {
      "column": 4,
      "endColumn": 16,
      "endLine": 52,
      "expression": "def forward(self, x):\n        # Since Chebyshev polynomial is defined in [-1, 1]\n        # We need to normalize x to [-1, 1] using tanh\n        # View and repeat input degree + 1 times\n        b, c_in = x.shape\n        if self.pre_mul:\n            mul_1 = x[:, ::2]\n            mul_2 = x[:, 1::2]\n            mul_res = mul_1 * mul_2\n            x = torch.concat([x[:, : x.shape[1] // 2], mul_res])\n        x = x.view((b, c_in, 1)).expand(\n            -1, -1, self.degree + 1\n        )  # shape = (batch_size, inputdim, self.degree + 1)\n        # Apply acos\n        x = torch.tanh(x)\n        x = torch.tanh(x)\n        x = torch.acos(x)\n        # x = torch.acos(torch.clamp(x, -1 + self.epsilon, 1 - self.epsilon))\n        # # Multiply by arange [0 .. degree]\n        x = x * self.arange\n        # Apply cos\n        x = x.cos()\n        # Compute the Chebyshev interpolation\n        y = torch.einsum(\n            \"bid,iod->bo\", x, self.cheby_coeffs\n        )  # shape = (batch_size, outdim)\n        y = y.view(-1, self.outdim)\n        if self.post_mul:\n            mul_1 = y[:, ::2]\n            mul_2 = y[:, 1::2]\n            mul_res = mul_1 * mul_2\n            y = torch.concat([y[:, : y.shape[1] // 2], mul_res])\n        return y",
      "line": 20,
      "path": "model.py",
      "sha256": "27c959f4c85d195a2715cd7688e51685837b1617ffe44d069828edb829e0d6c7"
    },
    "sourceFiles": [
      {
        "path": "model.py",
        "sha256": "801501991050aac8a4a18c64ce646dbcf3ce581b8b4a7f9c18bb3b5631e352e5"
