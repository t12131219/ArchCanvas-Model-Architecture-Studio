NN.flatten","portId":"call:instance:model.ResidualCNN.flatten:in:input"},"tensorId":"tensor:call:instance:model.ResidualCNN.pool:output","role":"data"},{"id":"edge:22","source":{"nodeId":"call:instance:model.ResidualCNN.flatten","portId":"call:instance:model.ResidualCNN.flatten:out:output"},"target":{"nodeId":"call:instance:model.ResidualCNN.classifier","portId":"call:instance:model.ResidualCNN.classifier:in:input"},"tensorId":"tensor:call:instance:model.ResidualCNN.flatten:output","role":"data"},{"id":"edge:23","source":{"nodeId":"call:instance:model.ResidualCNN.classifier","portId":"call:instance:model.ResidualCNN.classifier:out:output"},"target":{"nodeId":"output:model.ResidualCNN:0","portId":"output:model.ResidualCNN:0:in:value"},"tensorId":"tensor:call:instance:model.ResidualCNN.classifier:output","role":"data"}],"diagnostics":[{"level":"info","message":"Static AST subset only. User code was not imported or executed; no inferred shapes or runtime verification. Source editing uses separately reviewed registered transactions."}],"sources":[{"path":"blocks.py","content":"\"\"\"Two-convolution residual block with equal channel widths.\"\"\"\n\nfrom torch import nn\n\n\nclass ResidualBlock(nn.Module):\n    def __init__(self, channels=16):\n        super().__init__()\n        self.conv1 = nn.Conv2d(channels, channels, 3, padding=1)\n        self.norm1 = nn.BatchNorm2d(channels)\n        self.activation = nn.ReLU()\n        self.conv2 = nn.Conv2d(channels, channels, 3, padding=1)\n        self.norm2 = nn.BatchNorm2d(channels)\n\n    def forward(self, x):\n        residual = x\n        x = self.activation(self.norm1(self.conv1(x)))\n        x = self.norm2(self.conv2(x))\n        return self.activation(x + residual)\n","digest":"bcd34a0fec4a6cda31f5387aa78a074855209c794fdf2a6133ba8d57d0ac5e5f"},{"path":"model.py","content":"\"\"\"Small real CNN source; blocks are independently constructed.\"\"\"\n\nfrom torch import nn\nfrom blocks import ResidualBlock\n\n\nclass ResidualCNN(nn.Module):\n    def __init__(self, channels=16, classes=10):\n        super().__init__()\n        self.stem = nn.Conv2d(3, channels, 3, padding=1)\n        self.blocks = nn.ModuleList([ResidualBlock(channels) for _ in range(2)])\n        self.pool = nn.AdaptiveAvgPool2d(1)\n        self.flatten = nn.Flatten(1)\n        self.classifier = nn.Linear(channels, classes)\n\n    def forward(self, image):\n        x = self.stem(image)\n        for block in self.blocks:\n            x = block(x)\n        x = self.flatten(self.pool(x))\n        return self.classifier(x)\n","digest":"a59b14dce0eef0f102620ba8246ff36343dbdfc96fb8eef9850acddab3970c15"}]},"displayAliases":{},"nodeStyleOverrides":{},"edgeStyleOverrides":{},"legendItems":[{"id":"legend:input","label":"Input","color":"#eef2f5","glyph":"tensor"},{"id":"legend:container","label":"Container","color":"#f5f8fc","glyph":"module"},{"id":"legend:norm","label":"Norm","color":"#f5e7ef","glyph":"norm"},{"id":"legend:activation","label":"Activation","color":"#f9eddc","glyph":"operator"},{"id":"legend:residual","label":"Residual","color":"#f4eddf","glyph":"add"},{"id":"legend:linear","label":"Linear","color":"#e5f1ed","glyph":"operator"}],"annotations":[],"pageSpec":{"widthMm":85,"background":"#ffffff","preset":"paper"},"expandedIds":["call:instance:model.ResidualCNN","repeat:instance:model.ResidualCNN.blocks","call:instance:model.ResidualCNN.blocks.0","call:instance:model.ResidualCNN.blocks.1"],"layout":{"call:instance:model.ResidualCNN":{"x":50,"y":92},"input:model.ResidualCNN:image":{"x":30,"y":62},"call:instance:model.ResidualCNN.stem":{"x":30,"y":162},"repeat:instance:model.ResidualCNN.blocks":{"x":30,"y":262},"call:instance:model.ResidualCNN.pool":{"x":30,"y":1938},"call:instance:model.ResidualCNN.flatten":{"x":30,"y":2038},"call:instance:model.ResidualCNN.classifier":{"x":30,"y":2138},"output:model.ResidualCNN:0":{"x":30,"y":2238},"call:instance:model.ResidualCNN.blocks.0":{"x":30,"y":62},"call:instance:model.Residu