        "source": {
          "path": "model.py",
          "line": 48,
          "endLine": 55,
          "expression": "def forward(self, image):\n        skip = self.stem(image)\n        for block in self.refinement:\n            skip = block(skip)\n        coarse = self.bottleneck(self.downsample(skip))\n        restored = self.upsample(coarse)\n        merged = torch.cat((skip, restored), dim=1)\n        return self.head(merged)"
        },
        "evidence": "source",
        "parentId": "call:instance:model.SkipSegmentation"
