    },
    {
      "area": "bounded-inspection",
      "behavior": "Breadth-first shallow sibling representation and max-min allocation by actual renderable demand. Unused small-region shares return to larger regions; registered replacements reclaim their old card budget.",
      "limits": {
        "totalPreviewNodes": 480,
        "totalPreviewEdges": 3600,
        "containmentDepth": 12
      },
      "residualLimitation": "Source inspection can remain truncated at depth/definition budgets even when visible node count is below 480; diagnostic coverage must remain explicit."
    },
    {
      "area": "selection-interoperability",
      "behavior": "Actual previewSelectionNodeIds consumes independently rebuilt callSites so an inspection card anchored in __init__ can select the corresponding formal call object."
    },
    {
      "area": "adapter-compatibility",
      "behavior": "source-inspection/2 is explicitly stale; rescan/scaffold, review and register current source-inspection/3 facts. Formal schema and both generation standards match revision 3."
    },
    {
      "area": "conditional-source-control-routing",
      "behavior": "Non-tensor source associations retain all canonical tensor lanes; bounded validated owner-side candidates and alternative top-side slots recover stacked expanded branches when a canonical tensor occupies the centre.",
