    {
      "area": "source-call-evidence",
      "generatorRevision": "source-inspection/3",
      "behavior": "Adapter SourceModule parameters.callSites records independently rebuilt real method call evidence alongside constructor source. Region selection uses call spans, source dependency spans, ancestors and descendants.",
