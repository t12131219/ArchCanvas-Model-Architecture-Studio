      "source": "from torch import nn\n\nclass PairFusion(nn.Module):\n    def __init__(self, width=4, bias=False):\n        super().__init__()\n        self.project = nn.Linear(width, width, bias=bias)\n\n    def forward(self, left, *, right):\n        return self.project(left), right\n",
