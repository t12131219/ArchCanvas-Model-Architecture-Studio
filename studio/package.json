{
  "name": "archcanvas-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "prototype:build": "tsc -p prototypes/scene-visual-lab/tsconfig.json && vite build --config prototypes/scene-visual-lab/vite.config.ts",
    "prototype:dev": "vite --config prototypes/scene-visual-lab/vite.config.ts",
    "prototype:serve": "vite preview --config prototypes/scene-visual-lab/vite.config.ts --host 127.0.0.1 --port 4312"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
