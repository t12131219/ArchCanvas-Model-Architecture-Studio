      "start": 148,
      "end": 153,
      "snippet": "    def forward(self, input):\n        out = F.pad(input, [1, 1, 1, 1], value=1)\n        out = self.conv(out)\n        out = out * torch.exp(self.scale * 3)\n\n        return out",
