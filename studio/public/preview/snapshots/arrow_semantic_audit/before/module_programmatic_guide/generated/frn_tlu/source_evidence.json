      "path": "rasbt-modules/pytorch_ipynb/cnn/nin-cifar10_filter-response-norm.py",
      "symbol": "FilterResponseNormalization.forward",
      "start": 28,
      "end": 37,
      "snippet": "    def forward(self, x):\n        # forward function based on\n        # https://github.com/gupta-abhay/pytorch-frn/blob/master/frn.py\n        n, c, h, w = x.size()\n        \n        self.eps = self.eps.to(self.tau.device)\n\n        nu2 = torch.mean(x.pow(2), (2, 3), keepdims=True)\n        x = x * torch.rsqrt(nu2 + torch.abs(self.eps))\n        return torch.max(self.gamma*x + self.beta, self.tau)",
