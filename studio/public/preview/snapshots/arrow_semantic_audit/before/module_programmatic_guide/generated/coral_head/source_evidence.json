      "symbol": "CoralLayer.__init__",
      "start": 135,
      "end": 145,
      "snippet": "    def __init__(self, size_in, num_classes, preinit_bias=True):\n        super().__init__()\n        self.size_in, self.size_out = size_in, 1\n\n        self.coral_weights = torch.nn.Linear(self.size_in, 1, bias=False)\n        if preinit_bias:\n            self.coral_bias = torch.nn.Parameter(\n                torch.arange(num_classes - 1, 0, -1).float() / (num_classes-1))\n        else:\n            self.coral_bias = torch.nn.Parameter(\n                torch.zeros(num_classes-1).float())",
      "notebook_cells": [
        17
      ],
      "original_notebook": "rasbt-ordinal-modules/pytorch_ipynb/ordinal/CORAL_cement.ipynb",
      "evidence_id": "E001"
    },
