      "path": "deeplearning-models/pytorch_ipynb/cnn/cnn-lenet5-mnist.py",
      "symbol": "LeNet5.forward",
      "start": 134,
      "end": 139,
      "snippet": "    def forward(self, x):\n        x = self.features(x)\n        x = torch.flatten(x, 1)\n        logits = self.classifier(x)\n        probas = F.softmax(logits, dim=1)\n        return logits, probas",
      "notebook_cells": [
