      "snippet": "    def forward(self, x):\n\n        x = self.block_1(x)\n        x = self.block_2(x)\n        x = self.block_3(x)\n        x = self.block_4(x)\n        x = self.block_5(x)\n        logits = self.classifier(x.view(-1, 512))\n        probas = F.softmax(logits, dim=1)\n\n        return logits, probas",
