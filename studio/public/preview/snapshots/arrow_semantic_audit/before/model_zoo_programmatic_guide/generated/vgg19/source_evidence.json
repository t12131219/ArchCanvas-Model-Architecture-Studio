    "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.py::compute_accuracy": {
      "path": "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.py",
      "symbol": "compute_accuracy",
      "start": 246,
      "end": 258,
      "snippet": "def compute_accuracy(model, data_loader):\n    model.eval()\n    correct_pred, num_examples = 0, 0\n    for i, (features, targets) in enumerate(data_loader):\n            \n        features = features.to(DEVICE)\n        targets = targets.to(DEVICE)\n\n        logits, probas = model(features)\n        _, predicted_labels = torch.max(probas, 1)\n        num_examples += targets.size(0)\n        correct_pred += (predicted_labels == targets).sum()\n    return correct_pred.float()/num_examples * 100",
      "notebook_cells": [
        12
      ],
      "original_notebook": "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.ipynb",
      "evidence_id": "E004"
    },
    "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.py::compute_epoch_loss": {
      "path": "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.py",
      "symbol": "compute_epoch_loss",
      "start": 261,
      "end": 274,
      "snippet": "def compute_epoch_loss(model, data_loader):\n    model.eval()\n    curr_loss, num_examples = 0., 0\n    with torch.no_grad():\n        for features, targets in data_loader:\n            features = features.to(DEVICE)\n            targets = targets.to(DEVICE)\n            logits, probas = model(features)\n            loss = F.cross_entropy(logits, targets, reduction='sum')\n            num_examples += targets.size(0)\n            curr_loss += loss\n\n        curr_loss = curr_loss / num_examples\n        return curr_loss",
      "notebook_cells": [
        12
      ],
      "original_notebook": "deeplearning-models-batch4/pytorch_ipynb/cnn/cnn-vgg19.ipynb",
      "evidence_id": "E005"
    }
