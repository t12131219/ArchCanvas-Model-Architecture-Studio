      "snippet": "    def forward(self, x):\n        \n        ### ENCODER\n        x = self.conv_1(x)\n        x = F.leaky_relu(x)\n        x = self.pool_1(x)\n        x = self.conv_2(x)\n        x = F.leaky_relu(x)\n        x = self.pool_2(x)\n        \n        ### DECODER\n        x = F.interpolate(x, scale_factor=2, mode='nearest')\n        x = self.conv_3(x)\n        x = F.leaky_relu(x)\n        x = F.interpolate(x, scale_factor=2, mode='nearest')\n        x = self.conv_4(x)\n        logits = F.leaky_relu(x)\n        probas = torch.sigmoid(logits)\n        return logits, probas",
