    "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.py::GraphNet.forward": {
      "path": "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.py",
      "symbol": "GraphNet.forward",
      "start": 131,
      "end": 152,
      "snippet": "    def forward(self, x):\n        \n        B = x.size(0) # Batch size\n\n        ### Reshape Adjacency Matrix\n        # [N, N] Adj. matrix -> [1, N, N] Adj tensor where N = HxW\n        A_tensor = self.A.unsqueeze(0)\n        # [1, N, N] Adj tensor -> [B, N, N] tensor\n        A_tensor = self.A.expand(B, -1, -1)\n        \n        ### Reshape inputs\n        # [B, C, H, W] => [B, H*W, 1]\n        x_reshape = x.view(B, -1, 1)\n        \n        # bmm = batch matrix product to sum the neighbor features\n        # Input: [B, N, N] x [B, N, 1]\n        # Output: [B, N]\n        avg_neighbor_features = (torch.bmm(A_tensor, x_reshape).view(B, -1))\n        \n        logits = self.fc(avg_neighbor_features)\n        probas = F.softmax(logits, dim=1)\n        return logits, probas",
      "notebook_cells": [
        15
      ],
      "original_notebook": "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.ipynb",
      "evidence_id": "E003"
    },
    "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.py::compute_acc": {
      "path": "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.py",
      "symbol": "compute_acc",
      "start": 163,
      "end": 172,
      "snippet": "def compute_acc(model, data_loader, device):\n    correct_pred, num_examples = 0, 0\n    for features, targets in data_loader:\n        features = features.to(device)\n        targets = targets.to(device)\n        logits, probas = model(features)\n        _, predicted_labels = torch.max(probas, 1)\n        num_examples += targets.size(0)\n        correct_pred += (predicted_labels == targets).sum()\n    return correct_pred.float()/num_examples * 100",
      "notebook_cells": [
        18
      ],
      "original_notebook": "deeplearning-models-batch4/pytorch_ipynb/gnn/gnn-basic-1.ipynb",
      "evidence_id": "E004"
    }
