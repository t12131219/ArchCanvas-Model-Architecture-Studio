    "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py::ResNet._make_layer": {
      "path": "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py",
      "symbol": "ResNet._make_layer",
      "start": 175,
      "end": 190,
      "snippet": "    def _make_layer(self, block, planes, blocks, stride=1):\n        downsample = None\n        if stride != 1 or self.inplanes != planes * block.expansion:\n            downsample = nn.Sequential(\n                nn.Conv2d(self.inplanes, planes * block.expansion,\n                          kernel_size=1, stride=stride, bias=False),\n                nn.BatchNorm2d(planes * block.expansion),\n            )\n\n        layers = []\n        layers.append(block(self.inplanes, planes, stride, downsample))\n        self.inplanes = planes * block.expansion\n        for i in range(1, blocks):\n            layers.append(block(self.inplanes, planes))\n\n        return nn.Sequential(*layers)",
      "notebook_cells": [
