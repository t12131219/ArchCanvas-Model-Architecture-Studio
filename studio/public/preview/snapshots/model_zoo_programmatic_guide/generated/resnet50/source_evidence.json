    "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py::compute_accuracy": {
      "path": "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py",
      "symbol": "compute_accuracy",
      "start": 230,
      "end": 241,
      "snippet": "def compute_accuracy(model, data_loader, device):\n    correct_pred, num_examples = 0, 0\n    for i, (features, targets) in enumerate(data_loader):\n            \n        features = features.to(device)\n        targets = targets.to(device)\n\n        logits, probas = model(features)\n        _, predicted_labels = torch.max(probas, 1)\n        num_examples += targets.size(0)\n        correct_pred += (predicted_labels == targets).sum()\n    return correct_pred.float()/num_examples * 100",
      "notebook_cells": [
        18
      ],
      "original_notebook": "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.ipynb",
      "evidence_id": "E008"
    }
