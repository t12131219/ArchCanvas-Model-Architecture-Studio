    "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py::resnet34": {
      "path": "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.py",
      "symbol": "resnet34",
      "start": 213,
      "end": 219,
      "snippet": "def resnet34(num_classes):\n    \"\"\"Constructs a ResNet-34 model.\"\"\"\n    model = ResNet(block=Bottleneck, \n                   layers=[3, 4, 6, 3],\n                   num_classes=NUM_CLASSES,\n                   grayscale=GRAYSCALE)\n    return model",
      "notebook_cells": [
        15
      ],
      "original_notebook": "deeplearning-models-batch3/pytorch_ipynb/cnn/cnn-resnet50-mnist.ipynb",
