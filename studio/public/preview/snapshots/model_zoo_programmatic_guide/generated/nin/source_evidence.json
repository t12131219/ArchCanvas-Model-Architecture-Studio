      "end": 157,
      "snippet": "    def forward(self, x):\n        x = self.classifier(x)\n        logits = x.view(x.size(0), self.num_classes)\n        probas = torch.softmax(logits, dim=1)\n        return logits, probas",
      "notebook_cells": [
