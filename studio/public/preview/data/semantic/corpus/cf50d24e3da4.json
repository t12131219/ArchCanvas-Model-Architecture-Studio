          "end_line": 27,
          "column": 4,
          "end_column": 52,
          "symbol": "RNN.forward",
          "expression": "def forward(self, text, text_length):\n    embedded = self.embedding(text)\n    packed = torch.nn.utils.rnn.pack_padded_sequence(embedded, text_length)\n    packed_output, (hidden, cell) = self.rnn(packed)\n    combined = torch.cat((hidden[-2, :, :], hidden[-1, :, :]), dim=1)\n    return self.fc(combined.squeeze(0)).view(-1)"
        }
      ],
