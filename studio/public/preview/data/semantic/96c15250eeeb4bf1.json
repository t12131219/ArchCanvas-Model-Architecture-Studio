      "source": [
        {
          "file": "/home/fzg/PycharmProjects/ArchCanvas/Source_Code_Project/deeplearning-models-master/deeplearning-models-master/pytorch_ipynb/gnn/gnn-basic-1.ipynb#cell=15",
          "line": 19,
          "end_line": 40,
          "column": 4,
          "end_column": 29,
          "symbol": "GraphNet.forward",
          "expression": "def forward(self, x):\n    B = x.size(0)\n    A_tensor = self.A.unsqueeze(0)\n    A_tensor = self.A.expand(B, -1, -1)\n    x_reshape = x.view(B, -1, 1)\n    avg_neighbor_features = torch.bmm(A_tensor, x_reshape).view(B, -1)\n    logits = self.fc(avg_neighbor_features)\n    probas = F.softmax(logits, dim=1)\n    return (logits, probas)"
        }
      ],
