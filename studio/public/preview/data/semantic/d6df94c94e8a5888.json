          "symbol": "MultilayerPerceptron.forward",
          "expression": "def forward(self, x):\n    out = self.linear_1(x)\n    out = F.relu(out)\n    out = self.linear_2(out)\n    out = F.relu(out)\n    logits = self.linear_out(out)\n    probas = F.log_softmax(logits, dim=1)\n    return (logits, probas)"
        }
