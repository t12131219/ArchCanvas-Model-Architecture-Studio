{
  "$defs": {
    "AnchorKind": {
      "enum": [
        "class",
        "function",
        "assignment",
        "call",
        "argument",
        "expression"
      ],
      "title": "AnchorKind",
      "type": "string"
    },
    "AnchorLocator": {
      "additionalProperties": false,
      "properties": {
        "argument_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Argument Name"
        },
        "assignment_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assignment Target"
        },
        "callee_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Callee Text"
        },
        "class_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Class Name"
        },
        "function_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Function Name"
        },
        "occurrence": {
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "qualified_callee": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qualified Callee"
        }
      },
      "required": [
        "class_name",
        "function_name",
        "assignment_target",
        "callee_text",
        "qualified_callee",
        "argument_name",
        "occurrence"
      ],
      "title": "AnchorLocator",
      "type": "object"
    },
    "Framework": {
      "enum": [
        "pytorch",
        "keras",
        "onnx",
        "unknown"
      ],
      "title": "Framework",
      "type": "string"
    },
    "IdentityReconciliation": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReconciliationDecision"
        },
        "new_discovery_id": {
          "minLength": 1,
          "title": "New Discovery Id",
          "type": "string"
        },
        "old_identity_id": {
          "anyOf": [
            {
              "pattern": "^identity:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Old Identity Id"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "resolved_identity_id": {
          "anyOf": [
            {
              "pattern": "^identity:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Identity Id"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "old_identity_id",
        "new_discovery_id",
        "resolved_identity_id",
        "score",
        "decision",
        "reasons"
      ],
      "title": "IdentityReconciliation",
      "type": "object"
    },
    "NodeIdentity": {
      "additionalProperties": false,
      "properties": {
        "anchor_ids": {
          "items": {
            "pattern": "^anchor:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Anchor Ids",
          "type": "array"
        },
        "attribute_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribute Path"
        },
        "created_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Created Revision",
          "type": "string"
        },
        "framework": {
          "$ref": "#/$defs/Framework"
        },
        "identity_id": {
          "pattern": "^identity:[A-Za-z0-9._-]+$",
          "title": "Identity Id",
          "type": "string"
        },
        "module_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Module Path"
        },
        "qualified_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qualified Symbol"
        },
        "relative_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative File"
        },
        "semantic_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Semantic Role"
        },
        "structural_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Structural Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "framework",
        "module_path",
        "relative_file",
        "qualified_symbol",
        "attribute_path",
        "semantic_role",
        "structural_fingerprint",
        "anchor_ids",
        "created_revision"
      ],
      "title": "NodeIdentity",
      "type": "object"
    },
    "ReconciliationDecision": {
      "enum": [
        "exact",
        "reconciled",
        "new",
        "ambiguous"
      ],
      "title": "ReconciliationDecision",
      "type": "string"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "pattern": "^anchor:[A-Za-z0-9._-]+$",
          "title": "Anchor Id",
          "type": "string"
        },
        "content_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Fingerprint",
          "type": "string"
        },
        "cst_node_type": {
          "minLength": 1,
          "title": "Cst Node Type",
          "type": "string"
        },
        "file_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "File Revision",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AnchorKind"
        },
        "locator": {
          "$ref": "#/$defs/AnchorLocator"
        },
        "relative_file": {
          "title": "Relative File",
          "type": "string"
        },
        "semantic_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Semantic Path"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "structural_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Structural Fingerprint",
          "type": "string"
        },
        "symbol_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol Path"
        }
      },
      "required": [
        "anchor_id",
        "relative_file",
        "symbol_path",
        "semantic_path",
        "kind",
        "cst_node_type",
        "span",
        "locator",
        "structural_fingerprint",
        "content_fingerprint",
        "file_revision"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "SourcePosition": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "title": "SourcePosition",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/SourcePosition"
        },
        "start": {
          "$ref": "#/$defs/SourcePosition"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://archcanvas.dev/schemas/source-identity-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchors": {
      "items": {
        "$ref": "#/$defs/SourceAnchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "file_revisions": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "File Revisions",
      "type": "object"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/NodeIdentity"
      },
      "title": "Identities",
      "type": "array"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "reconciliations": {
      "items": {
        "$ref": "#/$defs/IdentityReconciliation"
      },
      "title": "Reconciliations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Revision",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "source_revision",
    "file_revisions",
    "anchors",
    "identities",
    "reconciliations"
  ],
  "title": "SourceIdentityDocument",
  "type": "object"
}
