{
  "$defs": {
    "MiniatureDisclosure": {
      "enum": [
        "evidence",
        "illustrative"
      ],
      "title": "MiniatureDisclosure",
      "type": "string"
    },
    "MiniatureEvidenceKind": {
      "description": "The permitted provenance for a scientific miniature.",
      "enum": [
        "static_tensor_spec",
        "runtime_summary",
        "deterministic_schematic",
        "publication_annotation"
      ],
      "title": "MiniatureEvidenceKind",
      "type": "string"
    },
    "PublicationAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^annotation:[A-Za-z0-9._-]+$",
          "title": "Annotation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "repeat",
            "residual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "text": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "target_node_id",
        "text",
        "kind"
      ],
      "title": "PublicationAnnotation",
      "type": "object"
    },
    "PublicationEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^publication-edge:[A-Za-z0-9._-]+$",
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PublicationEdgeKind"
        },
        "member_edge_ids": {
          "items": {
            "pattern": "^edge:[A-Za-z0-9._:>-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Edge Ids",
          "type": "array"
        },
        "source_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "kind",
        "member_edge_ids"
      ],
      "title": "PublicationEdge",
      "type": "object"
    },
    "PublicationEdgeKind": {
      "enum": [
        "data",
        "residual"
      ],
      "title": "PublicationEdgeKind",
      "type": "string"
    },
    "PublicationMiniature": {
      "additionalProperties": false,
      "description": "A source-mapped visual preview with explicit evidence or schematic disclosure.",
      "properties": {
        "disclosure": {
          "$ref": "#/$defs/MiniatureDisclosure"
        },
        "evidence_kind": {
          "$ref": "#/$defs/MiniatureEvidenceKind"
        },
        "kind": {
          "$ref": "#/$defs/PublicationMiniatureKind"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "member_node_ids": {
          "items": {
            "pattern": "^node:[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Node Ids",
          "type": "array"
        },
        "miniature_id": {
          "pattern": "^miniature:[A-Za-z0-9._-]+$",
          "title": "Miniature Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "miniature_id",
        "target_node_id",
        "kind",
        "evidence_kind",
        "disclosure",
        "label",
        "member_node_ids"
      ],
      "title": "PublicationMiniature",
      "type": "object"
    },
    "PublicationMiniatureKind": {
      "description": "Read-only scientific visual grammars, never additional architecture nodes.",
      "enum": [
        "tensor_strip",
        "signal_preview",
        "distribution_preview",
        "equation_note",
        "inset_callout"
      ],
      "title": "PublicationMiniatureKind",
      "type": "string"
    },
    "PublicationNode": {
      "additionalProperties": false,
      "properties": {
        "collapsed": {
          "title": "Collapsed",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/PublicationNodeKind"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "member_node_ids": {
          "items": {
            "pattern": "^node:[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Node Ids",
          "type": "array"
        },
        "node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "kind",
        "label",
        "member_node_ids",
        "collapsed"
      ],
      "title": "PublicationNode",
      "type": "object"
    },
    "PublicationNodeKind": {
      "enum": [
        "input",
        "module",
        "repeat_group",
        "residual_block",
        "output"
      ],
      "title": "PublicationNodeKind",
      "type": "string"
    }
  },
  "$id": "https://archcanvas.dev/schemas/publication-ir-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/PublicationAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/PublicationEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "exact_ir_id": {
      "pattern": "^ir:[A-Za-z0-9._-]+$",
      "title": "Exact Ir Id",
      "type": "string"
    },
    "miniatures": {
      "items": {
        "$ref": "#/$defs/PublicationMiniature"
      },
      "title": "Miniatures",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/PublicationNode"
      },
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "omitted_exact_edge_ids": {
      "items": {
        "pattern": "^edge:[A-Za-z0-9._:>-]+$",
        "type": "string"
      },
      "title": "Omitted Exact Edge Ids",
      "type": "array"
    },
    "omitted_exact_node_ids": {
      "items": {
        "pattern": "^node:[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "title": "Omitted Exact Node Ids",
      "type": "array"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^publication:[A-Za-z0-9._-]+$",
      "title": "Publication Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Revision",
      "type": "string"
    }
  },
  "required": [
    "publication_id",
    "exact_ir_id",
    "project_id",
    "source_revision",
    "nodes",
    "edges",
    "annotations",
    "omitted_exact_node_ids",
    "omitted_exact_edge_ids"
  ],
  "title": "PublicationIR",
  "type": "object"
}
