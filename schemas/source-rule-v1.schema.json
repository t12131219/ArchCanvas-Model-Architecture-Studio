{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcanvas.local/schemas/source-rule-v1.schema.json",
  "title": "Portable source AST inspection rule",
  "description": "Bounded JSON AST patterns and selectors. Runtime validation additionally proves field validity, containment, direct value operands and comprehension lexical scope. No Python execution, tensor contracts or source generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "match", "nodes", "relations"],
  "properties": {
    "schema": {"const": "archcanvas-source-rule/1"},
    "id": {"type": "string", "pattern": "^rule-[a-f0-9]{24}$", "description": "Optional on submission; independently calculated from canonical template contents."},
    "name": {"$ref": "#/$defs/plainText"},
    "match": {"$ref": "#/$defs/pattern"},
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "at", "parent", "kind"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "at": {"$ref": "#/$defs/path"},
          "parent": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
          "kind": {"enum": ["SourceExpression", "SourceCall", "SourceLoop", "SourceBranch", "SourceStatement"]},
          "label": {"$ref": "#/$defs/plainText"}
        }
      }
    },
    "relations": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "target", "proof"],
        "properties": {
          "source": {"$ref": "#/$defs/key"},
          "target": {"$ref": "#/$defs/key"},
          "proof": {"enum": ["expression-input", "comprehension-iteration"]}
        }
      }
    }
  },
  "$defs": {
    "plainText": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f]+$"},
    "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "path": {"type": "array", "maxItems": 16, "items": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, {"type": "integer", "minimum": 0}]}},
    "pattern": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "description": "A built-in AST class; the root must be locatable."},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/patternValue"}, "description": "Only declared fields constrain the match; omitted fields are wildcards."}
      }
    },
    "patternValue": {
      "anyOf": [
        {"$ref": "#/$defs/pattern"},
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/patternValue"}, "description": "Declared list patterns match exactly, including length."}
      ]
    }
  }
}
