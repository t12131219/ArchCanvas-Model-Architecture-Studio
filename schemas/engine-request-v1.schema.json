{
  "$defs": {
    "CanvasAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^canvas-annotation:[A-Za-z0-9._-]+$",
          "title": "Annotation Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "target_node_id",
        "text"
      ],
      "title": "CanvasAnnotation",
      "type": "object"
    },
    "CanvasDocument": {
      "additionalProperties": false,
      "description": "Persisted visual state keyed to one immutable Publication IR revision.\n\nThis model intentionally contains no architecture parameters, source anchors, ports,\nedges, or source-write payload. Those facts belong to other, independently validated\nprotocols.",
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/CanvasAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "base_source_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Source Revision",
          "type": "string"
        },
        "canvas_document_id": {
          "pattern": "^canvas-document:[A-Za-z0-9._-]+$",
          "title": "Canvas Document Id",
          "type": "string"
        },
        "layout_mode": {
          "$ref": "#/$defs/CanvasLayoutMode",
          "default": "automatic"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CanvasNodeState"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^publication:[A-Za-z0-9._-]+$",
          "title": "Publication Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/CanvasViewport"
        }
      },
      "required": [
        "canvas_document_id",
        "project_id",
        "publication_id",
        "base_source_revision",
        "viewport",
        "nodes"
      ],
      "title": "CanvasDocument",
      "type": "object"
    },
    "CanvasLayoutMode": {
      "enum": [
        "automatic",
        "manual"
      ],
      "title": "CanvasLayoutMode",
      "type": "string"
    },
    "CanvasNodeState": {
      "additionalProperties": false,
      "description": "Per-publication-node visual state; it cannot encode a graph or source patch.",
      "properties": {
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "height": {
          "maximum": 640,
          "minimum": 40,
          "title": "Height",
          "type": "number"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "publication_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Publication Node Id",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/CanvasNodeStyle"
        },
        "width": {
          "maximum": 1200,
          "minimum": 80,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "publication_node_id",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "CanvasNodeState",
      "type": "object"
    },
    "CanvasNodeStyle": {
      "additionalProperties": false,
      "description": "A deliberately small, visual-only style palette.",
      "properties": {
        "accent_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accent Color"
        },
        "fill_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Color"
        },
        "stroke_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Color"
        }
      },
      "title": "CanvasNodeStyle",
      "type": "object"
    },
    "CanvasViewport": {
      "additionalProperties": false,
      "description": "The client viewport, intentionally independent from publication geometry.",
      "properties": {
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        },
        "zoom": {
          "maximum": 4.0,
          "minimum": 0.1,
          "title": "Zoom",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "title": "CanvasViewport",
      "type": "object"
    },
    "EngineEnvironment": {
      "additionalProperties": false,
      "properties": {
        "dependency_lockfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Lockfile"
        },
        "environment_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment Name"
        },
        "python_executable": {
          "minLength": 1,
          "title": "Python Executable",
          "type": "string"
        }
      },
      "required": [
        "python_executable"
      ],
      "title": "EngineEnvironment",
      "type": "object"
    },
    "ExpectedGraphDelta": {
      "additionalProperties": false,
      "properties": {
        "allowed_edge_additions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Edge Additions",
          "type": "array"
        },
        "allowed_edge_modifications": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Edge Modifications",
          "type": "array"
        },
        "allowed_edge_removals": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Edge Removals",
          "type": "array"
        },
        "allowed_node_additions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Node Additions",
          "type": "array"
        },
        "allowed_node_modifications": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Node Modifications",
          "type": "array"
        },
        "allowed_node_removals": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Node Removals",
          "type": "array"
        },
        "require_identity_retention": {
          "title": "Require Identity Retention",
          "type": "boolean"
        },
        "required_parameter_changes": {
          "items": {
            "$ref": "#/$defs/ParameterChange"
          },
          "title": "Required Parameter Changes",
          "type": "array"
        }
      },
      "required": [
        "require_identity_retention"
      ],
      "title": "ExpectedGraphDelta",
      "type": "object"
    },
    "HealthCommand": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "health",
          "default": "health",
          "title": "Operation",
          "type": "string"
        }
      },
      "title": "HealthCommand",
      "type": "object"
    },
    "InsertLayerNormPatch": {
      "additionalProperties": false,
      "description": "Stage 8's first structural operation: splice one LayerNorm into a proven data edge.",
      "properties": {
        "attribute_name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Attribute Name",
          "type": "string"
        },
        "constructor_anchor_content_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Constructor Anchor Content Fingerprint",
          "type": "string"
        },
        "constructor_anchor_id": {
          "pattern": "^anchor:[A-Za-z0-9._-]+$",
          "title": "Constructor Anchor Id",
          "type": "string"
        },
        "expected_delta": {
          "$ref": "#/$defs/ExpectedGraphDelta"
        },
        "forward_anchor_content_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Forward Anchor Content Fingerprint",
          "type": "string"
        },
        "forward_anchor_id": {
          "pattern": "^anchor:[A-Za-z0-9._-]+$",
          "title": "Forward Anchor Id",
          "type": "string"
        },
        "normalized_shape": {
          "minimum": 1,
          "title": "Normalized Shape",
          "type": "integer"
        },
        "operation": {
          "const": "insert_layer_norm",
          "default": "insert_layer_norm",
          "title": "Operation",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^patch:[A-Za-z0-9._-]+$",
          "title": "Patch Id",
          "type": "string"
        },
        "scope": {
          "const": "architecture",
          "default": "architecture",
          "title": "Scope",
          "type": "string"
        },
        "source_node_id": {
          "pattern": "^node:[A-Za-z0-9._:-]+$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^node:[A-Za-z0-9._:-]+$",
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "patch_id",
        "source_node_id",
        "target_node_id",
        "constructor_anchor_id",
        "forward_anchor_id",
        "attribute_name",
        "normalized_shape",
        "constructor_anchor_content_fingerprint",
        "forward_anchor_content_fingerprint",
        "expected_delta"
      ],
      "title": "InsertLayerNormPatch",
      "type": "object"
    },
    "OpenProjectCommand": {
      "additionalProperties": false,
      "properties": {
        "approved_root": {
          "minLength": 1,
          "title": "Approved Root",
          "type": "string"
        },
        "entrypoint": {
          "pattern": "^[A-Za-z0-9_./-]+\\.py:[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Entrypoint",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EngineEnvironment"
        },
        "operation": {
          "const": "open_project",
          "default": "open_project",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "resolved_config": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Resolved Config",
          "type": "object"
        }
      },
      "required": [
        "project_id",
        "approved_root",
        "entrypoint",
        "environment"
      ],
      "title": "OpenProjectCommand",
      "type": "object"
    },
    "ParameterChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "node_id": {
          "pattern": "^node:[A-Za-z0-9._:-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter",
        "before",
        "after"
      ],
      "title": "ParameterChange",
      "type": "object"
    },
    "PatchCommand": {
      "additionalProperties": false,
      "properties": {
        "confirmation_id": {
          "anyOf": [
            {
              "pattern": "^confirmation:[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmation Id"
        },
        "operation": {
          "enum": [
            "plan_patch",
            "validate_patch",
            "commit_patch"
          ],
          "title": "Operation",
          "type": "string"
        },
        "patch_set": {
          "$ref": "#/$defs/PatchSet"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "project_id",
        "patch_set"
      ],
      "title": "PatchCommand",
      "type": "object"
    },
    "PatchSet": {
      "additionalProperties": false,
      "properties": {
        "base_source_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Source Revision",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "enum": [
            "user",
            "agent",
            "system"
          ],
          "title": "Created By",
          "type": "string"
        },
        "patch_set_id": {
          "pattern": "^patchset:[A-Za-z0-9._-]+$",
          "title": "Patch Set Id",
          "type": "string"
        },
        "patches": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/SetParameterPatch"
              },
              {
                "$ref": "#/$defs/InsertLayerNormPatch"
              }
            ]
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Patches",
          "type": "array"
        },
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "patch_set_id",
        "project_id",
        "base_source_revision",
        "created_at",
        "created_by",
        "patches"
      ],
      "title": "PatchSet",
      "type": "object"
    },
    "PatchTarget": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "pattern": "^anchor:[A-Za-z0-9._-]+$",
          "title": "Anchor Id",
          "type": "string"
        },
        "node_id": {
          "pattern": "^node:[A-Za-z0-9._:-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter",
        "anchor_id"
      ],
      "title": "PatchTarget",
      "type": "object"
    },
    "ProjectCommand": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "analyze_project",
            "refresh_project",
            "replay_visual_patches",
            "replay_canvas_documents",
            "load_analysis"
          ],
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "project_id"
      ],
      "title": "ProjectCommand",
      "type": "object"
    },
    "ResolveSourceAnchorCommand": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "pattern": "^anchor:[A-Za-z0-9._-]+$",
          "title": "Anchor Id",
          "type": "string"
        },
        "operation": {
          "const": "resolve_source_anchor",
          "default": "resolve_source_anchor",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "anchor_id"
      ],
      "title": "ResolveSourceAnchorCommand",
      "type": "object"
    },
    "SaveCanvasDocumentCommand": {
      "additionalProperties": false,
      "properties": {
        "canvas_document": {
          "$ref": "#/$defs/CanvasDocument"
        },
        "operation": {
          "const": "save_canvas_document",
          "default": "save_canvas_document",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "canvas_document"
      ],
      "title": "SaveCanvasDocumentCommand",
      "type": "object"
    },
    "SaveVisualPatchCommand": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "save_visual_patch",
          "default": "save_visual_patch",
          "title": "Operation",
          "type": "string"
        },
        "visual_patch": {
          "$ref": "#/$defs/VisualPatch"
        }
      },
      "required": [
        "visual_patch"
      ],
      "title": "SaveVisualPatchCommand",
      "type": "object"
    },
    "SetParameterPatch": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "anchor_content_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Anchor Content Fingerprint",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "expected_delta": {
          "$ref": "#/$defs/ExpectedGraphDelta"
        },
        "operation": {
          "const": "set_parameter",
          "default": "set_parameter",
          "title": "Operation",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^patch:[A-Za-z0-9._-]+$",
          "title": "Patch Id",
          "type": "string"
        },
        "scope": {
          "const": "architecture",
          "default": "architecture",
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/PatchTarget"
        }
      },
      "required": [
        "patch_id",
        "target",
        "before",
        "after",
        "anchor_content_fingerprint",
        "expected_delta"
      ],
      "title": "SetParameterPatch",
      "type": "object"
    },
    "VisualAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^visual-annotation:[A-Za-z0-9._-]+$",
          "title": "Annotation Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "text": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "target_node_id",
        "text"
      ],
      "title": "VisualAnnotation",
      "type": "object"
    },
    "VisualPatch": {
      "additionalProperties": false,
      "description": "Persisted presentation state; it contains no source or architecture edit payload.",
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/VisualAnnotation"
          },
          "title": "Annotations",
          "type": "array"
        },
        "base_source_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Source Revision",
          "type": "string"
        },
        "expanded_node_ids": {
          "items": {
            "pattern": "^publication-node:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Expanded Node Ids",
          "type": "array"
        },
        "project_id": {
          "pattern": "^project:[A-Za-z0-9._-]+$",
          "title": "Project Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^publication:[A-Za-z0-9._-]+$",
          "title": "Publication Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "visual_patch_id": {
          "pattern": "^visual-patch:[A-Za-z0-9._-]+$",
          "title": "Visual Patch Id",
          "type": "string"
        }
      },
      "required": [
        "visual_patch_id",
        "project_id",
        "publication_id",
        "base_source_revision"
      ],
      "title": "VisualPatch",
      "type": "object"
    }
  },
  "$id": "https://archcanvas.dev/schemas/engine-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "discriminator": {
        "mapping": {
          "analyze_project": "#/$defs/ProjectCommand",
          "commit_patch": "#/$defs/PatchCommand",
          "health": "#/$defs/HealthCommand",
          "load_analysis": "#/$defs/ProjectCommand",
          "open_project": "#/$defs/OpenProjectCommand",
          "plan_patch": "#/$defs/PatchCommand",
          "refresh_project": "#/$defs/ProjectCommand",
