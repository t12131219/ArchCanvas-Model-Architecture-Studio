{
  "$defs": {
    "NetworkPolicy": {
      "enum": [
        "deny",
        "inherit"
      ],
      "title": "NetworkPolicy",
      "type": "string"
    },
    "RuntimeEnvironment": {
      "additionalProperties": false,
      "properties": {
        "cuda_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cuda Version"
        },
        "dependency_lockfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dependency Lockfile"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device"
        },
        "environment_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment Name"
        },
        "network_enforcement": {
          "enum": [
            "best_effort",
            "not_requested"
          ],
          "title": "Network Enforcement",
          "type": "string"
        },
        "network_policy": {
          "$ref": "#/$defs/NetworkPolicy"
        },
        "python_executable": {
          "title": "Python Executable",
          "type": "string"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Python Version"
        },
        "torch_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Torch Version"
        }
      },
      "required": [
        "python_executable",
        "python_version",
        "torch_version",
        "cuda_version",
        "device",
        "network_policy",
        "network_enforcement",
        "environment_name",
        "dependency_lockfile"
      ],
      "title": "RuntimeEnvironment",
      "type": "object"
    },
    "RuntimeNodeObservation": {
      "additionalProperties": false,
      "properties": {
        "input_tensor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "output_tensor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "operation",
        "input_tensor",
        "output_tensor"
      ],
      "title": "RuntimeNodeObservation",
      "type": "object"
    },
    "RuntimeProviderId": {
      "enum": [
        "torch_fx",
        "torch_export"
      ],
      "title": "RuntimeProviderId",
      "type": "string"
    },
    "SymbolicDim": {
      "additionalProperties": false,
      "properties": {
        "lower_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "symbol": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Symbol",
          "type": "string"
        },
        "upper_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "SymbolicDim",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dtype"
        },
        "requires_grad": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requires Grad"
        },
        "semantic_axes": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Semantic Axes",
          "type": "array"
        },
        "shape": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "$ref": "#/$defs/SymbolicDim"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "dtype",
        "device",
        "requires_grad",
        "semantic_axes"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TraceFailureCode": {
      "enum": [
        "INVALID_REQUEST",
        "STALE_ENTRYPOINT_REVISION",
        "ENTRYPOINT_NOT_FOUND",
        "MODEL_IMPORT_FAILED",
        "MODEL_CONSTRUCTION_FAILED",
        "INPUT_CONSTRUCTION_FAILED",
        "PROVIDER_UNAVAILABLE",
        "TRACE_UNSUPPORTED",
        "WORKER_TIMEOUT",
        "WORKER_PROTOCOL_ERROR",
        "WORKER_EXITED"
      ],
      "title": "TraceFailureCode",
      "type": "string"
    },
    "TraceStatus": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "rejected"
      ],
      "title": "TraceStatus",
      "type": "string"
    }
  },
  "$id": "https://archcanvas.dev/schemas/runtime-trace-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/RuntimeEnvironment"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceFailureCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Message"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RuntimeNodeObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "peak_memory_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peak Memory Bytes"
    },
    "provider": {
      "$ref": "#/$defs/RuntimeProviderId"
    },
    "request_id": {
      "pattern": "^trace-request:[A-Za-z0-9._-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Revision",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TraceStatus"
    },
    "stderr": {
      "title": "Stderr",
      "type": "string"
    },
    "stderr_truncated": {
      "title": "Stderr Truncated",
      "type": "boolean"
    },
    "stdout": {
      "title": "Stdout",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^trace:[A-Za-z0-9._-]+$",
      "title": "Trace Id",
      "type": "string"
    },
    "worker_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Worker Exit Code"
    }
  },
  "required": [
    "trace_id",
    "request_id",
    "provider",
    "source_revision",
    "status",
    "failure_code",
    "message",
    "environment",
    "observations",
    "coverage_gaps",
    "elapsed_ms",
    "worker_exit_code",
    "stdout",
    "stderr",
    "stderr_truncated"
  ],
  "title": "RuntimeTraceResult",
  "type": "object"
}
