{
  "$defs": {
    "VisualAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^visual-annotation:[A-Za-z0-9._-]+$",
          "title": "Annotation Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "text": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "target_node_id",
        "text"
      ],
      "title": "VisualAnnotation",
      "type": "object"
    }
  },
  "$id": "https://archcanvas.dev/schemas/visual-patch-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persisted presentation state; it contains no source or architecture edit payload.",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/VisualAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "base_source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Source Revision",
      "type": "string"
    },
    "expanded_node_ids": {
      "items": {
        "pattern": "^publication-node:[A-Za-z0-9._-]+$",
        "type": "string"
      },
      "title": "Expanded Node Ids",
      "type": "array"
    },
    "project_id": {
      "pattern": "^project:[A-Za-z0-9._-]+$",
      "title": "Project Id",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^publication:[A-Za-z0-9._-]+$",
      "title": "Publication Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "visual_patch_id": {
      "pattern": "^visual-patch:[A-Za-z0-9._-]+$",
      "title": "Visual Patch Id",
      "type": "string"
    }
  },
  "required": [
    "visual_patch_id",
    "project_id",
    "publication_id",
    "base_source_revision"
  ],
  "title": "VisualPatch",
  "type": "object"
}
