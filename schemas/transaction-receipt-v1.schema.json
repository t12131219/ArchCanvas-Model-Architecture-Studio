{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^[A-Z][A-Za-z0-9_-]+$",
          "title": "Gate",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "message"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "TransactionState": {
      "enum": [
        "draft",
        "planned",
        "prepared",
        "source-validated",
        "reanalyzed",
        "graph-delta-validated",
        "tests-passed",
        "review-ready",
        "committed",
        "discarded",
        "failed"
      ],
      "title": "TransactionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_writes": {
      "title": "Source Writes",
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/TransactionState"
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "state",
    "status",
    "source_writes"
  ],
  "title": "TransactionReceipt",
  "type": "object"
}
