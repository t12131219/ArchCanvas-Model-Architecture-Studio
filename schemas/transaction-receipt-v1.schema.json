{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^[A-Z][A-Za-z0-9_-]+$",
          "title": "Gate",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "message"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "TransactionState": {
      "enum": [
        "draft",
        "planned",
        "prepared",
        "source-validated",
        "reanalyzed",
        "graph-delta-validated",
        "tests-passed",
        "review-ready",
        "committed",
        "discarded",
        "failed"
      ],
      "title": "TransactionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "default": "source-artifact",
      "enum": [
        "source-artifact",
        "model-artifact"
      ],
      "title": "Artifact Kind",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "framework": {
      "default": "pytorch",
      "enum": [
        "pytorch",
        "keras",
        "jax",
        "onnx"
      ],
      "title": "Framework",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "inference_compatibility": {
      "default": "not-bound",
      "enum": [
        "verified",
        "partial",
        "blocked",
        "not-bound"
      ],
      "title": "Inference Compatibility",
      "type": "string"
    },
    "proposal_correlation_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Correlation Id"
    },
    "realized_subject_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Realized Subject Ids",
      "type": "array"
    },
    "recovery_receipt_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Receipt Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_status": {
      "default": "prepared",
      "enum": [
        "prepared",
        "verified",
        "committed",
        "failed",
        "discarded"
      ],
      "title": "Source Status",
      "type": "string"
    },
    "source_writes": {
      "title": "Source Writes",
      "type": "boolean"
    },
    "state": {
      "$ref": "#/$defs/TransactionState"
    },
    "state_compatibility": {
      "default": "not-bound",
      "enum": [
        "verified",
        "partial",
        "blocked",
        "not-bound"
      ],
      "title": "State Compatibility",
      "type": "string"
    },
    "state_migration_plan_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State Migration Plan Id"
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "training_resume_compatibility": {
      "default": "not-bound",
      "enum": [
        "verified",
        "partial",
        "blocked",
        "not-bound"
      ],
      "title": "Training Resume Compatibility",
      "type": "string"
    },
    "transaction_adapter_id": {
      "default": "transaction:pytorch-source-v1",
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Adapter Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "state",
    "status",
    "source_writes"
  ],
  "title": "TransactionReceipt",
  "type": "object"
}
