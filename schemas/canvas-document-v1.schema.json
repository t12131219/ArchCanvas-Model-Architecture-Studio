{
  "$defs": {
    "VisualPatch": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "set-position",
            "set-size",
            "set-pin",
            "set-alignment",
            "set-gap",
            "set-route-hint",
            "set-label-wrap",
            "set-caption",
            "set-legend-placement",
            "set-theme",
            "set-palette",
            "set-line-weight",
            "set-font-scale",
            "set-collapse",
            "set-camera",
            "add-annotation"
          ],
          "title": "Operation",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Patch Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "patch_id",
        "operation",
        "value"
      ],
      "title": "VisualPatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Architecture Id",
      "type": "string"
    },
    "base_hierarchy_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Hierarchy Id"
    },
    "document_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "redo_patches": {
      "items": {
        "$ref": "#/$defs/VisualPatch"
      },
      "title": "Redo Patches",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "view_state": {
      "additionalProperties": true,
      "title": "View State",
      "type": "object"
    },
    "visual_patches": {
      "items": {
        "$ref": "#/$defs/VisualPatch"
      },
      "title": "Visual Patches",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "source_snapshot_id",
    "architecture_id",
    "source_digest"
  ],
  "title": "CanvasDocument",
  "type": "object"
}
