{
  "$defs": {
    "EdgeType": {
      "enum": [
        "main",
        "residual",
        "skip",
        "memory",
        "state",
        "condition",
        "routing",
        "parameter-share",
        "training-only"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "SceneAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Annotation Id",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/SceneRect"
        },
        "fill": {
          "default": "#fff8c5",
          "minLength": 1,
          "title": "Fill",
          "type": "string"
        },
        "stroke": {
          "default": "#8a6d1d",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "text",
        "bounds"
      ],
      "title": "SceneAnnotation",
      "type": "object"
    },
    "SceneEdge": {
      "additionalProperties": false,
      "properties": {
        "canonical_edge_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Canonical Edge Ids",
          "type": "array"
        },
        "dash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dash"
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ScenePoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "scene_edge_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Scene Edge Id",
          "type": "string"
        },
        "source_scene_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Source Scene Node Id",
          "type": "string"
        },
        "stroke": {
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "target_scene_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target Scene Node Id",
          "type": "string"
        },
        "view_edge_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "View Edge Id",
          "type": "string"
        },
        "visual_relation": {
          "$ref": "#/$defs/VisualRelation",
          "default": "sequence"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "scene_edge_id",
        "view_edge_id",
        "canonical_edge_ids",
        "source_scene_node_id",
        "target_scene_node_id",
        "points",
        "role",
        "edge_type",
        "stroke",
        "width",
        "label"
      ],
      "title": "SceneEdge",
      "type": "object"
    },
    "SceneNode": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/SceneRect"
        },
        "canonical_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Canonical Node Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fill": {
          "minLength": 1,
          "title": "Fill",
          "type": "string"
        },
        "label_lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Label Lines",
          "type": "array"
        },
        "parent_scene_node_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Scene Node Id"
        },
        "scene_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Scene Node Id",
          "type": "string"
        },
        "secondary_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary Label"
        },
        "shape": {
          "enum": [
            "container",
            "rect",
            "tensor",
            "merge",
            "io",
            "state",
            "opaque",
            "projection",
            "activation",
            "normalization",
            "attention",
            "transform",
            "condition",
            "repeat"
          ],
          "title": "Shape",
          "type": "string"
        },
        "stroke": {
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "view_node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "View Node Id",
          "type": "string"
        }
      },
      "required": [
        "scene_node_id",
        "view_node_id",
        "bounds",
        "shape",
        "label_lines",
        "fill",
        "stroke"
      ],
      "title": "SceneNode",
      "type": "object"
    },
    "ScenePoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ScenePoint",
      "type": "object"
    },
    "SceneRect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "SceneRect",
      "type": "object"
    },
    "VisualRelation": {
      "description": "Evidence-derived diagram grammar layered over canonical edge semantics.",
      "enum": [
        "sequence",
        "parallel-branch",
        "merge",
        "residual",
        "shape-transform",
        "memory-reference",
        "condition",
        "routing",
        "state-update",
        "parameter-share",
        "training-only"
      ],
      "title": "VisualRelation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SceneAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "caption": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/SceneEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "layout_family": {
      "minLength": 1,
      "title": "Layout Family",
      "type": "string"
    },
    "legend_placement": {
      "anyOf": [
        {
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right",
            "hidden"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legend Placement"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/SceneNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "paper_height": {
      "exclusiveMinimum": 0,
      "title": "Paper Height",
      "type": "number"
    },
    "paper_width": {
      "exclusiveMinimum": 0,
      "title": "Paper Width",
      "type": "number"
    },
    "scene_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Spec Id",
      "type": "string"
    },
    "view_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "View Id",
      "type": "string"
    }
  },
  "required": [
    "scene_id",
    "view_id",
    "spec_id",
    "layout_family",
    "paper_width",
    "paper_height",
    "nodes"
  ],
  "title": "VisualScene",
  "type": "object"
}
