{
  "$defs": {
    "EntryInvocationConfig": {
      "additionalProperties": false,
      "properties": {
        "constructor_args": {
          "items": {},
          "title": "Constructor Args",
          "type": "array"
        },
        "constructor_kwargs": {
          "additionalProperties": true,
          "title": "Constructor Kwargs",
          "type": "object"
        },
        "forward_args": {
          "items": {},
          "title": "Forward Args",
          "type": "array"
        },
        "forward_kwargs": {
          "additionalProperties": true,
          "title": "Forward Kwargs",
          "type": "object"
        },
        "input_structure": {
          "default": null,
          "title": "Input Structure"
        },
        "mode": {
          "default": "eval",
          "enum": [
            "eval",
            "train"
          ],
          "title": "Mode",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "static_args": {
          "additionalProperties": true,
          "title": "Static Args",
          "type": "object"
        }
      },
      "title": "EntryInvocationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "config_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Path"
    },
    "entry_invocation": {
      "$ref": "#/$defs/EntryInvocationConfig"
    },
    "entrypoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entrypoint"
    },
    "environment_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Path"
    },
    "execution_policy": {
      "default": "static-only",
      "enum": [
        "static-only",
        "runtime-opt-in"
      ],
      "title": "Execution Policy",
      "type": "string"
    },
    "form_id": {
      "default": "form:python-callable",
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Form Id",
      "type": "string"
    },
    "framework": {
      "default": "auto",
      "title": "Framework",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "opened_at": {
      "minLength": 1,
      "title": "Opened At",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "python_executable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Python Executable"
    },
    "root": {
      "minLength": 1,
      "title": "Root",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "default": "inference",
      "title": "Task",
      "type": "string"
    },
    "workspace": {
      "minLength": 1,
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "root",
    "generation",
    "config_digest",
    "workspace",
    "opened_at"
  ],
  "title": "ProjectSession",
  "type": "object"
}
