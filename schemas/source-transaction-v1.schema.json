{
  "$defs": {
    "AffectedObjectReviewBinding": {
      "additionalProperties": false,
      "properties": {
        "affected_object_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Object Ids",
          "type": "array"
        },
        "decision": {
          "enum": [
            "pending",
            "confirmed",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "parameter_sharing_group_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Parameter Sharing Group Ids",
          "type": "array"
        },
        "review_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "reviewed_generation": {
          "minimum": 1,
          "title": "Reviewed Generation",
          "type": "integer"
        },
        "source_anchor_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Anchor Ids",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "affected_object_ids",
        "decision",
        "reviewed_generation"
      ],
      "title": "AffectedObjectReviewBinding",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
