{
  "$defs": {
    "FrameworkFormCapability": {
      "additionalProperties": false,
      "properties": {
        "artifact_commit": {
          "enum": [
            "verified",
            "experimental",
            "partial",
            "unavailable"
          ],
          "title": "Artifact Commit",
          "type": "string"
        },
        "form_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Form Id",
          "type": "string"
        },
        "form_name": {
          "minLength": 1,
          "title": "Form Name",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "parameter_transaction": {
          "enum": [
            "verified",
            "experimental",
            "partial",
            "unavailable"
          ],
          "title": "Parameter Transaction",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "verified",
            "experimental",
            "partial",
            "unavailable"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "static": {
          "enum": [
            "verified",
            "experimental",
            "partial",
            "unavailable"
          ],
          "title": "Static",
          "type": "string"
        },
        "structural_transaction": {
          "enum": [
            "verified",
            "experimental",
            "partial",
            "unavailable"
          ],
          "title": "Structural Transaction",
          "type": "string"
        },
        "supported_targets": {
          "items": {
            "type": "string"
          },
          "title": "Supported Targets",
          "type": "array"
        },
        "verified_fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Verified Fixtures",
          "type": "array"
        }
      },
      "required": [
        "form_id",
        "form_name",
        "static",
        "runtime",
        "parameter_transaction",
        "structural_transaction",
        "artifact_commit"
      ],
      "title": "FrameworkFormCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "artifact_commit": {
      "default": false,
      "title": "Artifact Commit",
      "type": "boolean"
    },
    "capability_status": {
      "additionalProperties": {
        "enum": [
          "verified",
          "experimental",
          "partial",
          "unavailable"
        ],
        "type": "string"
      },
      "title": "Capability Status",
      "type": "object"
    },
    "forms": {
      "items": {
        "$ref": "#/$defs/FrameworkFormCapability"
      },
      "title": "Forms",
      "type": "array"
    },
    "framework": {
      "enum": [
        "pytorch",
        "keras",
        "jax",
        "onnx"
      ],
      "title": "Framework",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "parameter_transactions": {
      "default": false,
      "title": "Parameter Transactions",
      "type": "boolean"
    },
    "required_packages": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Required Packages",
      "type": "object"
    },
    "runtime_evidence": {
      "title": "Runtime Evidence",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_transactions": {
      "title": "Source Transactions",
      "type": "boolean"
    },
    "static_analysis": {
      "title": "Static Analysis",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "verified",
        "experimental",
        "partial",
        "unavailable",
        "supported"
      ],
      "title": "Status",
      "type": "string"
    },
    "structural_transactions": {
      "default": false,
      "title": "Structural Transactions",
      "type": "boolean"
    },
    "supported_forms": {
      "items": {
        "type": "string"
      },
      "title": "Supported Forms",
      "type": "array"
    },
    "supported_targets": {
      "items": {
        "type": "string"
      },
      "title": "Supported Targets",
      "type": "array"
    },
    "verified_fixtures": {
      "items": {
        "type": "string"
      },
      "title": "Verified Fixtures",
      "type": "array"
    }
  },
  "required": [
    "adapter_id",
    "framework",
    "adapter_version",
    "status",
    "static_analysis",
    "runtime_evidence",
    "source_transactions"
  ],
  "title": "FrameworkAdapterCapability",
  "type": "object"
}
