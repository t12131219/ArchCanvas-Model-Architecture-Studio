{
  "$defs": {
    "ArchitectureEdge": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consumer_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Consumer Id",
          "type": "string"
        },
        "consumer_port": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Consumer Port",
          "type": "string"
        },
        "edge_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "execution_predicate": {
          "minLength": 1,
          "title": "Execution Predicate",
          "type": "string"
        },
        "producer_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Producer Id",
          "type": "string"
        },
        "producer_port": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Producer Port",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "semantic_axes": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Axes",
          "type": "array"
        },
        "symbolic_shape": {
          "default": "[?]",
          "minLength": 1,
          "title": "Symbolic Shape",
          "type": "string"
        },
        "tensor_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Tensor Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "tensor_id",
        "producer_id",
        "producer_port",
        "consumer_id",
        "consumer_port",
        "role",
        "edge_type",
        "confidence",
        "execution_predicate"
      ],
      "title": "ArchitectureEdge",
      "type": "object"
    },
    "ArchitectureNode": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "execution_predicate": {
          "minLength": 1,
          "title": "Execution Predicate",
          "type": "string"
        },
        "input_ports": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Input Ports",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "output_ports": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Output Ports",
          "type": "array"
        },
        "parameter_identity": {
          "default": "not-applicable",
          "minLength": 1,
          "title": "Parameter Identity",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "semantic_name": {
          "minLength": 1,
          "title": "Semantic Name",
          "type": "string"
        },
        "source_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        }
      },
      "required": [
        "node_id",
        "kind",
        "semantic_name",
        "execution_predicate",
        "confidence"
      ],
      "title": "ArchitectureNode",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "exact",
        "runtime-confirmed",
        "equivalent",
        "inferred",
        "unresolved",
        "reference-only",
        "contradicted"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EdgeType": {
      "enum": [
        "main",
        "residual",
        "skip",
        "memory",
        "state",
        "condition",
        "routing",
        "parameter-share",
        "training-only"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "NodeKind": {
      "enum": [
        "module_container",
        "operator",
        "merge_event",
        "condition_control",
        "state",
        "input_output"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "port_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Port Id",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "port_id",
        "name",
        "direction",
        "role"
      ],
      "title": "Port",
      "type": "object"
    },
    "Repeat": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "count_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count Symbol"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/RepeatKind"
        },
        "member_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Node Ids",
          "type": "array"
        },
        "parameter_identity": {
          "minLength": 1,
          "title": "Parameter Identity",
          "type": "string"
        },
        "repeat_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Repeat Id",
          "type": "string"
        }
      },
      "required": [
        "repeat_id",
        "kind",
        "member_node_ids",
        "parameter_identity"
      ],
      "title": "Repeat",
      "type": "object"
    },
    "RepeatKind": {
      "enum": [
        "stack",
        "time",
        "scale",
        "outer-iteration",
        "dynamic-route"
      ],
      "title": "RepeatKind",
      "type": "string"
    },
    "TensorValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "consumer_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Consumer Ids",
          "type": "array"
        },
        "dtype": {
          "default": "unknown",
          "title": "Dtype",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "producer_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Producer Id",
          "type": "string"
        },
        "producer_port": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Producer Port",
          "type": "string"
        },
        "provenance": {
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "semantic_axes": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Axes",
          "type": "array"
        },
        "symbolic_shape": {
          "default": "[?]",
          "minLength": 1,
          "title": "Symbolic Shape",
          "type": "string"
        },
        "tensor_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Tensor Id",
          "type": "string"
        }
      },
      "required": [
        "tensor_id",
        "role",
        "producer_id",
        "producer_port",
        "consumer_ids",
        "provenance",
        "confidence"
      ],
      "title": "TensorValue",
      "type": "object"
    },
    "UnresolvedFact": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "blocking"
      ],
      "title": "UnresolvedFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Architecture Id",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/ArchitectureEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "entrypoint": {
      "minLength": 3,
      "title": "Entrypoint",
      "type": "string"
    },
    "framework": {
      "minLength": 1,
      "title": "Framework",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ArchitectureNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "repeats": {
      "items": {
        "$ref": "#/$defs/Repeat"
      },
      "title": "Repeats",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "tensors": {
      "items": {
        "$ref": "#/$defs/TensorValue"
      },
      "title": "Tensors",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/UnresolvedFact"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "architecture_id",
    "source_snapshot_id",
    "framework",
    "entrypoint",
    "nodes"
  ],
  "title": "ArchitectureIR",
  "type": "object"
}
