{
  "$defs": {
    "PublicationNodeKind": {
      "enum": [
        "input",
        "module",
        "repeat_group",
        "residual_block",
        "output"
      ],
      "title": "PublicationNodeKind",
      "type": "string"
    },
    "ReadingDirection": {
      "enum": [
        "left_to_right",
        "bottom_to_top",
        "mixed"
      ],
      "title": "ReadingDirection",
      "type": "string"
    },
    "VisualCanvas": {
      "additionalProperties": false,
      "properties": {
        "composition_mode": {
          "const": "integrated",
          "default": "integrated",
          "title": "Composition Mode",
          "type": "string"
        },
        "default_detail_level": {
          "const": "L1",
          "default": "L1",
          "title": "Default Detail Level",
          "type": "string"
        },
        "opening_policy": {
          "const": "overview",
          "default": "overview",
          "title": "Opening Policy",
          "type": "string"
        },
        "reading_direction": {
          "$ref": "#/$defs/ReadingDirection",
          "default": "left_to_right"
        }
      },
      "title": "VisualCanvas",
      "type": "object"
    },
    "VisualConstraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "before",
          "title": "Kind",
          "type": "string"
        },
        "source_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_node_id",
        "target_node_id"
      ],
      "title": "VisualConstraint",
      "type": "object"
    },
    "VisualEdge": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "pattern": "^publication-edge:[A-Za-z0-9._-]+$",
          "title": "Canonical Id",
          "type": "string"
        },
        "edge_type": {
          "enum": [
            "main",
            "residual"
          ],
          "title": "Edge Type",
          "type": "string"
        },
        "route_preference": {
          "const": "orthogonal",
          "default": "orthogonal",
          "title": "Route Preference",
          "type": "string"
        },
        "source_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Source Node Id",
          "type": "string"
        },
        "source_port_id": {
          "anyOf": [
            {
              "pattern": "^port:[A-Za-z0-9._:>-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Port Id"
        },
        "target_node_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Target Node Id",
          "type": "string"
        },
        "target_port_id": {
          "anyOf": [
            {
              "pattern": "^port:[A-Za-z0-9._:>-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Port Id"
        }
      },
      "required": [
        "canonical_id",
        "source_node_id",
        "target_node_id",
        "edge_type"
      ],
      "title": "VisualEdge",
      "type": "object"
    },
    "VisualNode": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "pattern": "^publication-node:[A-Za-z0-9._-]+$",
          "title": "Canonical Id",
          "type": "string"
        },
        "children": {
          "items": {
            "pattern": "^publication-node:[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        },
        "detail_level": {
          "const": "L1",
          "default": "L1",
          "title": "Detail Level",
          "type": "string"
        },
        "inline_expand": {
          "default": false,
          "title": "Inline Expand",
          "type": "boolean"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^publication-node:[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/VisualPort"
          },
          "title": "Ports",
          "type": "array"
        },
        "visual_class": {
          "$ref": "#/$defs/PublicationNodeKind"
        }
      },
      "required": [
        "canonical_id",
        "label",
        "visual_class"
      ],
      "title": "VisualNode",
      "type": "object"
    },
    "VisualPort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "port_id": {
          "pattern": "^port:[A-Za-z0-9._:>-]+$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "port_id",
        "direction"
      ],
      "title": "VisualPort",
      "type": "object"
    },
    "VisualViewPolicy": {
      "additionalProperties": false,
      "properties": {
        "direct_full_detail_supported": {
          "default": false,
          "title": "Direct Full Detail Supported",
          "type": "boolean"
        }
      },
      "title": "VisualViewPolicy",
      "type": "object"
    }
  },
  "$id": "https://archcanvas.dev/schemas/visual-spec-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "$ref": "#/$defs/VisualCanvas"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/VisualConstraint"
      },
      "title": "Constraints",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/VisualEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/VisualNode"
      },
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "publication_id": {
      "pattern": "^publication:[A-Za-z0-9._-]+$",
      "title": "Publication Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Revision",
      "type": "string"
    },
    "spec_id": {
      "pattern": "^visual-spec:[A-Za-z0-9._-]+$",
      "title": "Spec Id",
      "type": "string"
    },
    "view_policy": {
      "$ref": "#/$defs/VisualViewPolicy"
    }
  },
  "required": [
    "spec_id",
    "publication_id",
    "source_revision",
    "nodes",
    "edges"
  ],
  "title": "VisualSpec",
  "type": "object"
}
