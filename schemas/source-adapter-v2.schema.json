{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archcanvas.local/schemas/source-adapter-v2.schema.json",
  "title": "Evidence-bound portable source rule instance",
  "description": "Current-source instances of independent AST templates. Runtime validation recompiles selections and syntax proofs; schema validation alone does not certify evidence.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "generatorRevision", "id", "binding", "config", "inputs", "outputs", "rules", "applications", "children", "dependencies", "diagnostics", "generationContract", "authority", "presentation"],
  "properties": {
    "schema": {"const": "archcanvas-source-adapter/2"},
    "generatorRevision": {"const": "source-rules/1"},
    "id": {"type": "string", "pattern": "^adapter-[a-f0-9]{24}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "method", "sourceFiles", "symbol", "methodSpan"],
      "properties": {
        "entry": {"type": "string"}, "method": {"type": "string"},
        "sourceFiles": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "symbol": {"allOf": [{"$ref": "#/$defs/source"}], "required": ["qualifiedName"]},
        "methodSpan": {"allOf": [{"$ref": "#/$defs/source"}], "required": ["sha256"]}
      }
    },
    "config": {"type": "object"},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["id", "name", "kind", "required", "source"], "properties": {"source": {"$ref": "#/$defs/source"}, "defaultSource": {"$ref": "#/$defs/source"}}}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["id", "path", "kind", "source"], "properties": {"source": {"$ref": "#/$defs/source"}}}},
    "rules": {"type": "array", "maxItems": 16, "items": {"allOf": [{"$ref": "source-rule-v1.schema.json"}], "required": ["id"]}},
    "applications": {
      "type": "array", "maxItems": 480,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ruleId", "matchKey", "source", "rootId", "nodeIds"],
        "properties": {"ruleId": {"$ref": "#/$defs/ruleId"}, "matchKey": {"$ref": "#/$defs/matchKey"}, "source": {"$ref": "#/$defs/source"}, "rootId": {"type": "string"}, "nodeIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}}}
      }
    },
    "children": {
      "type": "array", "maxItems": 480,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "kind", "category", "parentId", "children", "ports", "parameters", "source", "evidence", "sourceStructure"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "kind": {"enum": ["SourceExpression", "SourceCall", "SourceLoop", "SourceBranch", "SourceStatement"]},
          "category": {"enum": ["operator", "container"]}, "parentId": {"type": ["string", "null"]},
          "children": {"type": "array", "items": {"type": "string"}}, "ports": {"const": []},
          "parameters": {
            "type": "object", "additionalProperties": false,
            "required": ["sourceRuleId", "sourceMatch", "sourceRulePath", "guards", "inspectionAuthority"],
            "properties": {"sourceRuleId": {"$ref": "#/$defs/ruleId"}, "sourceMatch": {"$ref": "#/$defs/matchKey"}, "sourceRulePath": {"$ref": "source-rule-v1.schema.json#/$defs/path"}, "guards": {"$ref": "#/$defs/guards"}, "inspectionAuthority": {"const": "syntax only; runtime path and repetition unverified"}}
          },
          "source": {"$ref": "#/$defs/source"}, "evidence": {"const": "source"}, "sourceStructure": {"const": true}
        }
      }
    },
    "dependencies": {
      "type": "array", "maxItems": 1440,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourceId", "targetId", "kind", "source", "proof", "sourceRuleId", "sourceMatch", "syntaxOnly", "guards"],
        "properties": {"id": {"type": "string"}, "sourceId": {"type": "string"}, "targetId": {"type": "string"}, "kind": {"const": "source-data-dependency"}, "source": {"$ref": "#/$defs/source"}, "proof": {"enum": ["expression-input", "comprehension-iteration"]}, "sourceRuleId": {"$ref": "#/$defs/ruleId"}, "sourceMatch": {"$ref": "#/$defs/matchKey"}, "syntaxOnly": {"const": true}, "guards": {"$ref": "#/$defs/guards"}}
      }
    },
    "diagnostics": {"const": []},
    "generationContract": {"type": "null"},
    "authority": {"const": "source-structure-only; no execution path, tensor ports, shapes, or source-generation authority"},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["labels", "notes"], "properties": {"labels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 240}}, "notes": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 240}}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ruleId": {"type": "string", "pattern": "^rule-[a-f0-9]{24}$"},
    "matchKey": {"type": "string", "pattern": "^match-[a-f0-9]{24}$"},
    "guards": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object", "required": ["path", "line", "endLine", "column", "endColumn", "expression"], "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0}, "endColumn": {"type": "integer", "minimum": 0}, "expression": {"type": "string"}, "qualifiedName": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
