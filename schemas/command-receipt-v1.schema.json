{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "unresolved",
            "suggestion"
          ],
          "title": "Severity",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^[A-Z][A-Za-z0-9_-]+$",
          "title": "Gate",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "message"
      ],
      "title": "GateResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "command": {
      "minLength": 1,
      "title": "Command",
      "type": "string"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "unavailable",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "command",
    "status",
    "exit_code"
  ],
  "title": "CommandReceipt",
  "type": "object"
}
