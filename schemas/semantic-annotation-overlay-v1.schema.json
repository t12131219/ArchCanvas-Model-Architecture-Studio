{
  "$defs": {
    "SemanticAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Annotation Id",
          "type": "string"
        },
        "canonical_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Canonical Node Ids",
          "type": "array"
        },
        "glyph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glyph"
        },
        "group_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "layout_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Family"
        },
        "pack_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Pack Id",
          "type": "string"
        },
        "predicate_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Predicate Ids",
          "type": "array"
        },
        "recommended_depth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Depth"
        },
        "semantic_role": {
          "minLength": 1,
          "title": "Semantic Role",
          "type": "string"
        }
      },
      "required": [
        "annotation_id",
        "pack_id",
        "canonical_node_ids",
        "semantic_role",
        "predicate_ids"
      ],
      "title": "SemanticAnnotation",
      "type": "object"
    },
    "VisualTemplateBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "binding_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Binding Id",
          "type": "string"
        },
        "edge_slots": {
          "patternProperties": {
            "^[a-z][a-z0-9._:-]*$": {
              "items": {
                "pattern": "^[a-z][a-z0-9._:-]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Edge Slots",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fidelity": {
          "enum": [
            "exact",
            "opaque",
            "schematic"
          ],
          "title": "Fidelity",
          "type": "string"
        },
        "node_slots": {
          "patternProperties": {
            "^[a-z][a-z0-9._:-]*$": {
              "items": {
                "pattern": "^[a-z][a-z0-9._:-]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Node Slots",
          "type": "object"
        },
        "port_slots": {
          "patternProperties": {
            "^[a-z][a-z0-9._:-]*$": {
              "items": {
                "pattern": "^[a-z][a-z0-9._:-]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Port Slots",
          "type": "object"
        },
        "predicate_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Predicate Ids",
          "type": "array"
        },
        "root_canonical_node_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Root Canonical Node Ids",
          "type": "array"
        },
        "template_id": {
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        },
        "tensor_slots": {
          "patternProperties": {
            "^[a-z][a-z0-9._:-]*$": {
              "items": {
                "pattern": "^[a-z][a-z0-9._:-]*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Tensor Slots",
          "type": "object"
        }
      },
      "required": [
        "binding_id",
        "template_id",
        "template_version",
        "root_canonical_node_ids",
        "fidelity",
        "binding_digest"
      ],
      "title": "VisualTemplateBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/SemanticAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "applied_pack_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Applied Pack Ids",
      "type": "array"
    },
    "architecture_id": {
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Architecture Id",
      "type": "string"
    },
    "exact_ir_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Exact Ir Digest",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "disabled",
        "generic",
        "matched",
        "ambiguous"
      ],
      "title": "Status",
      "type": "string"
    },
    "template_bindings": {
      "items": {
        "$ref": "#/$defs/VisualTemplateBinding"
      },
      "title": "Template Bindings",
      "type": "array"
    }
  },
  "required": [
    "architecture_id",
    "exact_ir_digest",
    "status"
  ],
  "title": "SemanticAnnotationOverlay",
  "type": "object"
}
